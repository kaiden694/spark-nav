          try {
            var rawFavs = localStorage.getItem('xiu_nav_user_favorites');
            var parsedFavs = rawFavs ? JSON.parse(rawFavs) : [];
            isFav = parsedFavs.some(function(x) { return x.id === cardId; });
          } catch (e) {
            isFav = false;
          }
        }
        var pinBtnHtml = '<button type="button" class="nav-card-pin-btn' + (isFav ? ' is-pinned' : '') + '" title="' + (isFav ? '从常用中移除' : '收藏至我的常用') + '" data-id="' + escapeHtml(cardId) + '">' +
          '<svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>' +
        '</button>';

        var relockBtnHtml = isNsfw ? (
          '<button type="button" class="nav-card-nsfw-relock-btn" title="重新启用防窥遮罩" style="' + (currentNsfwMode === 'blur' && !a.classList.contains('is-blurred') ? '' : 'display: none;') + '">' +
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>' +
          '</button>'
        ) : '';

        var reportBtnHtml = '<button type="button" class="nav-card-report-btn" title="反馈失联或分类纠错" data-title="' + escapeHtml(item.title || item.username) + '" data-url="' + escapeHtml(item.url || '') + '" data-alive="' + (item.is_alive !== false ? 'true' : 'false') + '">' +
          '<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>' +
        '</button>';

        var actionsHtml = '<div class="nav-card-actions-group">' + relockBtnHtml + feedBtnHtml + pinBtnHtml + copyBtnHtml + reportBtnHtml + '</div>';
        var offlineBadge = (item.is_alive === false) ? '<span class="nav-card-offline-pill" title="该频道当前可能已注销、被封禁或长期失联">⚠️ 可能失联</span>' : '';
        var nsfwBadge = isNsfw ? '<span class="nav-badge badge-nsfw" title="此内容属于成人敏感类目 (NSFW)">🔞 18+</span>' : '';

        var overlayHtml = isNsfw ? (
          '<div class="nav-card-nsfw-overlay">' +
            '<div class="nav-card-nsfw-badge">🔞 敏感内容 · 隐私防窥</div>' +
            '<div class="nav-card-nsfw-title">' + escapeHtml(item.title || item.username) + '</div>' +
            '<div class="nav-card-nsfw-hint">公共场合已启用防窥遮罩，点击解锁查看</div>' +
            '<button type="button" class="nav-card-nsfw-unlock-btn" title="临时解锁查看敏感内容">' +
              '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>' +
              '<span>点击解锁查看</span>' +
            '</button>' +
          '</div>'
        ) : '';

        a.innerHTML = 
          overlayHtml +
          '<div>' +
            '<div class="nav-card-header">' +
              '<div class="nav-card-avatar icon-small" style="background: #0088cc; color: #fff;">' +
                avatarHtml +
              '</div>' +
              '<div class="nav-card-info">' +
                '<div class="nav-card-title-row">' +
                  '<span class="nav-card-title" title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + '</span>' +
                  offlineBadge +
                  nsfwBadge +
                  '<span class="nav-badge badge-tg">' + typeBadge + '</span>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<p class="nav-card-desc">' + escapeHtml(item.description || item.username) + '</p>' +
          '</div>' +
          '<div class="nav-card-footer">' +
            '<div class="nav-card-tags">' + tagsHtml + '</div>' +
            '<div class="nav-card-stat">' +
              (countText ? '<span>' + countText + '</span>' : '<span class="nav-card-action">访问 &rarr;</span>') +
              actionsHtml +
            '</div>' +
          '</div>';

        if (isNsfw) {
          a.addEventListener('click', function(e) {
            if (a.classList.contains('is-blurred')) {
              e.preventDefault();
              e.stopPropagation();
              a.classList.remove('is-blurred');
              var relock = a.querySelector('.nav-card-nsfw-relock-btn');
              if (relock && currentNsfwMode === 'blur') {
                relock.style.display = 'inline-flex';
              }
              showNavToast('🔓 已临时解锁该敏感内容 (再次点击即可直达)');
            }
          });

          var relockBtn = a.querySelector('.nav-card-nsfw-relock-btn');
          if (relockBtn) {
            relockBtn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              a.classList.add('is-blurred');
              relockBtn.style.display = 'none';
              showNavToast('🔒 已重新启用防窥遮罩');
            });
          }
        }

        var pinBtn = a.querySelector('.nav-card-pin-btn');
        if (pinBtn) {
          var doPin = function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (e.__navPinHandled__) return;
            e.__navPinHandled__ = true;
            if (typeof window.executeNavCardPin === 'function') {
              window.executeNavCardPin(pinBtn);
              return;
            }
            if (window.toggleNavFavorite) {
              var isNowPinned = window.toggleNavFavorite({
                id: cardId,
                title: item.title,
                url: item.url,
                description: item.description || item.username,
                icon: item.icon_url || '',
                item_type: 'telegram'
              });
              if (isNowPinned) {
                pinBtn.classList.add('is-pinned');
                pinBtn.setAttribute('title', '从常用中移除');
                showNavToast('✓ 已添加至我的常用收藏');
              } else {
                pinBtn.classList.remove('is-pinned');
                pinBtn.setAttribute('title', '收藏至我的常用');
                showNavToast('✓ 已从我的常用中移除');
              }
            }
          };
          pinBtn.addEventListener('click', doPin);
          pinBtn.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') doPin(e);
          });
        }

        var copyBtn = a.querySelector('.nav-card-copy-btn');
        if (copyBtn) {
          var doCopy = function(e) {
            e.preventDefault();
            e.stopPropagation();
            var deepLink = window.location.origin + window.location.pathname + '#' + cardId;
            copyToClipboard(deepLink, function() {
              var oldHtml = copyBtn.innerHTML;
              copyBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
              copyBtn.classList.add('is-copied');
              setTimeout(function() {
                copyBtn.innerHTML = oldHtml;
                copyBtn.classList.remove('is-copied');
              }, 1600);
              showNavToast('✓ 直达链接已复制到剪贴板');
              history.replaceState(null, '', '#' + cardId);
              a.classList.remove('card-anchor-highlight');
              void a.offsetWidth;
              a.classList.add('card-anchor-highlight');
              setTimeout(function() { a.classList.remove('card-anchor-highlight'); }, 3000);
            });
          };

          copyBtn.addEventListener('click', doCopy);
          copyBtn.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              doCopy(e);
            }
          });
        }

        var reportBtn = a.querySelector('.nav-card-report-btn');
        if (reportBtn) {
          reportBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var targetTitle = reportBtn.getAttribute('data-title');
            var targetUrl = reportBtn.getAttribute('data-url');
            var isAlive = reportBtn.getAttribute('data-alive') === 'true';
            if (typeof window.openNavReportModal === 'function') {
              window.openNavReportModal({
                target: targetTitle + (targetUrl ? ' (' + targetUrl + ')' : ''),
                issueType: !isAlive ? 'broken' : 'cat_err',
                details: ''
              });
            }
          });
        }

        attach3DTilt(a, 6);
        return a;
      }

      function appendBatch() {
        if (renderedCount >= filteredItems.length) {
          loadMoreWrap.style.display = 'none';
          return;
        }

        var nextBatch = filteredItems.slice(renderedCount, renderedCount + BATCH_SIZE);
        var fragment = document.createDocumentFragment();
        for (var i = 0; i < nextBatch.length; i++) {
          fragment.appendChild(renderCard(nextBatch[i], renderedCount + i));
        }
        cardGrid.appendChild(fragment);
        renderedCount += nextBatch.length;

        if (typeof window.applyNavCustomFeeds === 'function') {
          window.applyNavCustomFeeds();
        }
        if (typeof window.refreshNavFeedCardBadges === 'function') {
          window.refreshNavFeedCardBadges();
        }
        if (typeof window.scheduleNavFeedPrefetch === 'function') {
          window.scheduleNavFeedPrefetch();
        }

        var remaining = filteredItems.length - renderedCount;
        if (remaining > 0) {
          loadMoreWrap.style.display = 'block';
          if (remainingEl) remainingEl.textContent = '(剩余 ' + remaining + ' 条)';
        } else {
          loadMoreWrap.style.display = 'none';
        }
      }

      function updateDynamicBadges() {
        // Count for type pills under currentSub, currentQuery and currentNsfwMode
        var typeCounts = { all: 0, channel: 0, bot: 0, group: 0 };
        for (var i = 0; i < allItems.length; i++) {
          var it = allItems[i];
          var isItemNsfw = Boolean(it.is_nsfw || (it.tags && it.tags.includes('NSFW')) || it.subcategory === 'nsfw');
          if (currentNsfwMode === 'hide' && isItemNsfw) continue;

          var matchSub = (currentSub === 'all' || it.subcategory === currentSub);
          var matchQ = !currentQuery || (it.title + ' ' + it.username + ' ' + (it.description || '')).toLowerCase().indexOf(currentQuery) !== -1;
          if (matchSub && matchQ) {
            typeCounts.all++;
            if (it.type === 'channel') typeCounts.channel++;
            else if (it.type === 'bot') typeCounts.bot++;
            else if (it.type === 'group') typeCounts.group++;
          }
        }

        var cAll = document.getElementById('count-type-all');
        var cCh = document.getElementById('count-type-channel');
        var cBot = document.getElementById('count-type-bot');
        var cGrp = document.getElementById('count-type-group');
        if (cAll) cAll.textContent = typeCounts.all;
        if (cCh) cCh.textContent = typeCounts.channel;
        if (cBot) cBot.textContent = typeCounts.bot;
        if (cGrp) cGrp.textContent = typeCounts.group;

        // Count for subcat pills under currentType, currentQuery and currentNsfwMode
        var subCounts = { all: 0 };
        var subBadges = document.querySelectorAll('[data-sub-badge]');
        for (var k = 0; k < allItems.length; k++) {
          var item = allItems[k];
          var isNsfwK = Boolean(item.is_nsfw || (item.tags && item.tags.includes('NSFW')) || item.subcategory === 'nsfw');
          if (currentNsfwMode === 'hide' && isNsfwK) continue;

          var matchType = (currentType === 'all' || item.type === currentType);
          var matchQuery = !currentQuery || (item.title + ' ' + item.username + ' ' + (item.description || '')).toLowerCase().indexOf(currentQuery) !== -1;
          if (matchType && matchQuery) {
            subCounts.all++;
            var s = item.subcategory || 'other';
            subCounts[s] = (subCounts[s] || 0) + 1;
          }
        }

        var cSubAll = document.getElementById('count-sub-all');
        if (cSubAll) cSubAll.textContent = subCounts.all;

        subBadges.forEach(function(badge) {
          var sid = badge.getAttribute('data-sub-badge');
          badge.textContent = subCounts[sid] || 0;
        });
      }

      function applyFilters(shouldSyncUrl) {
        var q = currentQuery.trim().toLowerCase();

        filteredItems = allItems.filter(function(item) {
          var isItemNsfw = Boolean(item.is_nsfw || (item.tags && item.tags.includes('NSFW')) || item.subcategory === 'nsfw');
          if (currentNsfwMode === 'hide' && isItemNsfw) {
            return false;
          }
          var matchesType = (currentType === 'all' || item.type === currentType);
          var matchesSub = (currentSub === 'all' || item.subcategory === currentSub);
          var text = (item.title + ' ' + item.username + ' ' + (item.description || '') + ' ' + (item.tags ? item.tags.join(' ') : '')).toLowerCase();
          var matchesQuery = !q || text.indexOf(q) !== -1;
          return matchesType && matchesSub && matchesQuery;
        });

        // Apply Health-Aware Sorting (Active items first, offline/dead items sink to bottom)
        filteredItems.sort(function(a, b) {
          var aAlive = (a.is_alive !== false) ? 1 : 0;
          var bAlive = (b.is_alive !== false) ? 1 : 0;
          if (aAlive !== bAlive) {
            return bAlive - aAlive;
          }
          if (currentSort === 'members') {
            return (b.member_count || 0) - (a.member_count || 0);
          } else if (currentSort === 'title') {
            return (a.title || a.username).localeCompare(b.title || b.username, 'zh-CN');
          }
          return 0;
        });

        // Update counts
        if (filteredCountEl) filteredCountEl.textContent = filteredItems.length;
        updateDynamicBadges();

        // Query tag display
        if (q) {
          if (queryTag) queryTag.style.display = 'inline-flex';
          if (queryText) queryText.textContent = q;
        } else {
          if (queryTag) queryTag.style.display = 'none';
        }

        var isModified = (currentType !== 'all' || currentSub !== 'all' || !!q || currentSort !== 'default');
        if (resetBtn) resetBtn.style.display = isModified ? 'inline-block' : 'none';

        // Reset grid and progressive append
        cardGrid.innerHTML = '';
        renderedCount = 0;

        if (filteredItems.length === 0) {
          emptyState.style.display = 'block';
          loadMoreWrap.style.display = 'none';

          if (fuzzyWrap && fuzzyList) {
            if (currentQuery) {
              var suggestions = computeFuzzySuggestions(currentQuery, allItems, 3);
              if (suggestions.length > 0) {
                fuzzyList.innerHTML = '';
                suggestions.forEach(function(title) {
                  var chip = document.createElement('button');
                  chip.type = 'button';
                  chip.className = 'nav-empty-fuzzy-chip';
                  chip.textContent = title;
                  chip.addEventListener('click', function() {
                    currentQuery = title;
                    if (searchInput) searchInput.value = title;
                    applyFilters(true);
                  });
                  fuzzyList.appendChild(chip);
                });
                fuzzyWrap.style.display = 'flex';
              } else {
                fuzzyWrap.style.display = 'none';
              }
            } else {
              fuzzyWrap.style.display = 'none';
            }
          }
        } else {
          emptyState.style.display = 'none';
          if (fuzzyWrap) fuzzyWrap.style.display = 'none';
          appendBatch();
        }

        if (shouldSyncUrl !== false) {
          syncUrlState();
        }
      }

      function syncUrlState() {
        if (!window.history || !window.history.replaceState) return;
        var params = new URLSearchParams();
        if (currentType !== 'all') params.set('type', currentType);
        if (currentSub !== 'all') params.set('sub', currentSub);
        if (currentSort !== 'default') params.set('sort', currentSort);
        if (currentQuery) params.set('q', currentQuery);

        var qs = params.toString();
        var newUrl = window.location.pathname + (qs ? '?' + qs : '');
        if (newUrl !== window.location.pathname + window.location.search) {
          window.history.replaceState(null, '', newUrl);
        }
      }

      function restoreStateFromUrl() {
        var params = new URLSearchParams(window.location.search);
        currentType = params.get('type') || 'all';
        currentSub = params.get('sub') || 'all';
        currentSort = params.get('sort') || 'default';
        currentQuery = params.get('q') || '';

        if (searchInput) searchInput.value = currentQuery;
        if (sortSelect) sortSelect.value = currentSort;

        typeButtons.forEach(function(btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-type') === currentType);
        });

        subcatButtons.forEach(function(btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-sub') === currentSub);
        });

        applyFilters(false);
      }

      // Event bindings
      typeButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var t = btn.getAttribute('data-type');
          if (t === currentType) return;
          typeButtons.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          currentType = t;
          applyFilters(true);
        });
      });

      subcatButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var s = btn.getAttribute('data-sub');
          if (s === currentSub) return;
          subcatButtons.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          currentSub = s;
          applyFilters(true);
        });
      });

      nsfwModeButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var m = btn.getAttribute('data-nsfw-mode');
          if (m === currentNsfwMode) return;
          currentNsfwMode = m;
          try {
            localStorage.setItem('xiu_nav_nsfw_mode', m);
          } catch (e) {}
          updateNsfwUiState();

          if (m === 'hide') {
            if (currentSub === 'nsfw') {
              currentSub = 'all';
              subcatButtons.forEach(function(b) {
                b.classList.toggle('is-active', b.getAttribute('data-sub') === 'all');
              });
            }
            applyFilters(true);
            showNavToast('🚫 已隐藏所有成人敏感内容');
          } else if (m === 'show') {
            applyFilters(true);
            showNavToast('👁️ 已切换为完全显示模式');
          } else {
            applyFilters(true);
            showNavToast('🛡️ 已启用隐私防窥保护 (默认高斯模糊遮罩)');
          }

          if (typeof window !== 'undefined') {
            window.dispatchEvent(new CustomEvent('xiu-nsfw-mode-changed', { detail: { mode: m } }));
          }
        });
      });

      if (searchInput) {
        var debounceTimer = null;
        searchInput.addEventListener('input', function() {
          currentQuery = searchInput.value;
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            applyFilters(true);
          }, 150);
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          currentSort = sortSelect.value;
          applyFilters(true);
        });
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          appendBatch();
        });
      }

      function resetAll() {
        currentType = 'all';
        currentSub = 'all';
        currentQuery = '';
        currentSort = 'default';
        if (searchInput) searchInput.value = '';
        if (sortSelect) sortSelect.value = 'default';

        typeButtons.forEach(function(b) { b.classList.toggle('is-active', b.getAttribute('data-type') === 'all'); });
        subcatButtons.forEach(function(b) { b.classList.toggle('is-active', b.getAttribute('data-sub') === 'all'); });

        applyFilters(true);
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
      if (clearQueryBtn) {
        clearQueryBtn.addEventListener('click', function() {
          currentQuery = '';
          if (searchInput) searchInput.value = '';
          applyFilters(true);
        });
      }

      // IntersectionObserver for seamless infinite append
      if ('IntersectionObserver' in window && sentinel) {
        var observer = new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting && renderedCount < filteredItems.length) {
            appendBatch();
          }
        }, { rootMargin: '400px 0px' });
        observer.observe(sentinel);
      }

      // Listen for browser popstate
      window.addEventListener('popstate', restoreStateFromUrl);

      if (btnShuffleSpotlight) {
        btnShuffleSpotlight.addEventListener('click', function(e) {
          triggerClickSpark(e, 8, '#f59e0b');
          pickSpotlightItem();
        });
      }

      var heroSpotlightCard = document.getElementById('hero-spotlight-card');
      if (heroSpotlightCard) {
        attach3DTilt(heroSpotlightCard, 5);
        heroSpotlightCard.addEventListener('mousemove', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
        heroSpotlightCard.addEventListener('mouseenter', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
      }

      if (cardGrid) {
        cardGrid.addEventListener('mousemove', function(e) {
          var card = e.target.closest('.nav-card');
          if (card) updateCardGlow(card, e);
        });
      }

      var cmdTriggerBadge = document.querySelector('.nav-key-shortcut');
      if (cmdTriggerBadge) {
        cmdTriggerBadge.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      var cmdSearchIcon = document.querySelector('.nav-search-icon');
      if (cmdSearchIcon) {
        cmdSearchIcon.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      function appendUntilTarget(targetId) {
        var targetIdx = -1;
        for (var i = 0; i < filteredItems.length; i++) {
          var it = filteredItems[i];
          if ((it.id && it.id === targetId) || ('tg-' + it.username) === targetId) {
            targetIdx = i;
            break;
          }
        }
        if (targetIdx >= 0) {
          while (renderedCount <= targetIdx && renderedCount < filteredItems.length) {
            appendBatch();
          }
        }
      }

      function handleHashDeepLink() {
        var hash = window.location.hash;
        if (!hash || hash.length <= 1) return;
        var targetId = decodeURIComponent(hash.slice(1));

        appendUntilTarget(targetId);

        var el = document.getElementById(targetId);
        if (el) {
          setTimeout(function() {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.remove('card-anchor-highlight');
            void el.offsetWidth;
            el.classList.add('card-anchor-highlight');
            setTimeout(function() { el.classList.remove('card-anchor-highlight'); }, 3000);
          }, 150);
        }
      }

      window.addEventListener('hashchange', handleHashDeepLink);

      // Initialize
      updateNsfwUiState();
      restoreStateFromUrl();
      pickSpotlightItem();
      setTimeout(handleHashDeepLink, 350);

      function syncTelegramPinButtons(favList) {
        var favs = favList;
        if (!favs) {
          if (typeof window.getNavFavorites === 'function') {
            favs = window.getNavFavorites();
          } else {
            try {
              var raw = localStorage.getItem('xiu_nav_user_favorites');
              favs = raw ? JSON.parse(raw) : [];
            } catch (e) {
              favs = [];
            }
          }
        }
        var favSet = new Set((favs || []).map(function(x) { return x.id; }));
        document.querySelectorAll('.nav-card-pin-btn').forEach(function(btn) {
          var id = btn.getAttribute('data-id');
          if (favSet.has(id)) {
            btn.classList.add('is-pinned');
            btn.setAttribute('title', '从常用中移除');
          } else {
            btn.classList.remove('is-pinned');
            btn.setAttribute('title', '收藏至我的常用');
          }
        });
      }

      window.addEventListener('nav-favorites-updated', function(e) {
        syncTelegramPinButtons(e.detail && e.detail.favorites);
      });

      window.addEventListener('nav-favorites-ready', function(e) {
        syncTelegramPinButtons(e.detail && e.detail.favorites);
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { syncTelegramPinButtons(); });
      } else {
        syncTelegramPinButtons();
      }
    })();
  </script>
</NavLayout>

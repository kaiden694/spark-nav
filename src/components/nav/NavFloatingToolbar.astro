    box-shadow: 0 4px 14px rgba(14, 165, 233, 0.35);
  }

  .nav-btn-bot:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .nav-btn-copy {
    background: rgba(255, 255, 255, 0.08);

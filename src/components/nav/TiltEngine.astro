---
// src/components/nav/TiltEngine.astro
// Unified 3D Tilt Parallax & Micro-Pitch Dynamic Engine for Navigation Hub & Cards
---
<script is:inline>
(function() {
  if (typeof window === 'undefined') return;
  if (window.__XIU_TILT_ENGINE_INITIALIZED__) return;
  window.__XIU_TILT_ENGINE_INITIALIZED__ = true;

  var prefersReducedQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
  var hoverQuery = window.matchMedia ? window.matchMedia('(hover: hover)') : null;
  var anyHoverQuery = window.matchMedia ? window.matchMedia('(any-hover: hover)') : null;

  var isDegradedPerf = false;
  var droppedFrameCount = 0;
  var lastFrameTime = 0;

  function canRunTilt() {
    if (isDegradedPerf) return false;
    if (prefersReducedQuery && prefersReducedQuery.matches) return false;
    // Require hover support; check both primary and any available pointer (supports Windows touch laptops with mouse/trackpad)
    if (hoverQuery && !hoverQuery.matches) {
      if (!anyHoverQuery || !anyHoverQuery.matches) return false;
    }
    return true;
  }

  function attach3DTilt(element, maxTilt) {
    if (!element || !canRunTilt()) return;
    if (element.__xiu_tilt_bound__) return;
    element.__xiu_tilt_bound__ = true;

    maxTilt = (typeof maxTilt === 'number') ? maxTilt : 8;
    element.style.transformStyle = 'preserve-3d';
    element.style.willChange = 'transform';

    var rect = null;
    var rafId = null;
    var resetTimer = null;

    function onPointerEnter(e) {
      if (e && e.pointerType === 'touch') return;
      if (resetTimer) { clearTimeout(resetTimer); resetTimer = null; }
      rect = element.getBoundingClientRect();
      element.style.transition = 'transform 0.1s ease-out, border-color 0.2s ease, box-shadow 0.2s ease';
    }

    function onPointerMove(e) {
      if (e && e.pointerType === 'touch') return;
      if (!rect) rect = element.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      // Stabilize hit target: freeze dynamic 3D tilt while hovering action buttons cluster
      if (e.target && e.target.closest && (e.target.closest('.nav-card-actions-group') || e.target.closest('.nav-card-pin-btn') || e.target.closest('.nav-card-copy-btn'))) {
        return;
      }

      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var centerX = rect.width / 2;
      var centerY = rect.height / 2;

      // Mouse at top -> rotateX > 0; mouse at bottom -> rotateX < 0
      // Mouse at left -> rotateY < 0; mouse at right -> rotateY > 0
      var rotateX = ((y - centerY) / centerY) * -maxTilt;
      var rotateY = ((x - centerX) / centerX) * maxTilt;

      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(function(now) {
        if (lastFrameTime > 0 && typeof now === 'number') {
          var delta = now - lastFrameTime;
          if (delta > 48) { // > 3 dropped frames at 60fps
            droppedFrameCount++;
            if (droppedFrameCount >= 8) {
              isDegradedPerf = true;
              element.style.transform = '';
              return;
            }
          } else if (droppedFrameCount > 0) {
            droppedFrameCount--;
          }
        }
        lastFrameTime = now;
        element.style.transform = 'perspective(800px) rotateX(' + rotateX.toFixed(2) + 'deg) rotateY(' + rotateY.toFixed(2) + 'deg) translateY(-4px)';
        element.style.setProperty('--mouse-x', x + 'px');
        element.style.setProperty('--mouse-y', y + 'px');
      });
    }

    function onPointerLeave(e) {
      if (rafId) cancelAnimationFrame(rafId);
      rect = null;
      element.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease';
      element.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0)';
      
      resetTimer = setTimeout(function() {
        if (!rect) {
          element.style.transform = '';
          element.style.transition = '';
        }
      }, 360);
    }

    if (window.PointerEvent) {
      element.addEventListener('pointerenter', onPointerEnter, { passive: true });
      element.addEventListener('pointermove', onPointerMove, { passive: true });
      element.addEventListener('pointerleave', onPointerLeave, { passive: true });
    } else {
      element.addEventListener('mouseenter', onPointerEnter, { passive: true });
      element.addEventListener('mousemove', onPointerMove, { passive: true });
      element.addEventListener('mouseleave', onPointerLeave, { passive: true });
    }
  }

  function init3DTilt(selector, maxTilt) {
    if (!canRunTilt()) return;
    var els = document.querySelectorAll(selector || '.nav-card');
    for (var i = 0; i < els.length; i++) {
      attach3DTilt(els[i], maxTilt);
    }
  }

  function autoMountAllCards() {
    if (!canRunTilt()) return;
    init3DTilt('.nav-card, .tgnav-portal-card, .spotlight-card, .cat-spotlight-card');
  }

  // Automatic binding fallback for static cards
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', autoMountAllCards);
  } else {
    autoMountAllCards();
  }

  // MutationObserver for dynamically injected cards (favorites, filters, search, async widgets)
  if (typeof MutationObserver !== 'undefined') {
    var observer = new MutationObserver(function(mutations) {
      if (!canRunTilt()) return;
      var hasNewNodes = false;
      for (var i = 0; i < mutations.length; i++) {
        if (mutations[i].addedNodes && mutations[i].addedNodes.length > 0) {
          hasNewNodes = true;
          break;
        }
      }
      if (hasNewNodes) {
        autoMountAllCards();
      }
    });
    if (document.body) {
      observer.observe(document.body, { childList: true, subtree: true });
    } else {
      document.addEventListener('DOMContentLoaded', function() {
        if (document.body) observer.observe(document.body, { childList: true, subtree: true });
      });
    }
  }

  window.attach3DTilt = attach3DTilt;
  window.init3DTilt = init3DTilt;
})();
</script>

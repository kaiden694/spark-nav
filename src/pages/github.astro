                ((typeof item.forks === 'number' || item.forks) ? (
                  '<span class="gh-stat-badge gh-stat-fork" title="Forks: ' + (item.forks || 0) + '">' +
                    '<svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align: -1px; margin-right: 2px;"><path d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg>' +
                    formatNum(item.forks) +
                  '</span>'
                ) : '') +
              '</div>' +
              actionsHtml +
            '</div>' +
          '</div>';

        var pinBtn = a.querySelector('.nav-card-pin-btn');
        if (pinBtn) {
          var doPin = function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (window.toggleNavFavorite) {
              var isNowPinned = window.toggleNavFavorite({
                id: cardId,
                title: item.title,
                url: item.url,
                description: item.description || item.repo,
                icon: item.icon_url || '',
                item_type: 'github'
              });
              if (isNowPinned) {
                pinBtn.classList.add('is-pinned');
                pinBtn.setAttribute('title', '从常用中移除');
                showNavToast('✓ 已添加至我的常用收藏');
              } else {
                pinBtn.classList.remove('is-pinned');
                pinBtn.setAttribute('title', '收藏至我的常用');
                showNavToast('✓ 已从我的常用中移除');
              }
            }
          };
          pinBtn.addEventListener('click', doPin);
          pinBtn.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') doPin(e);
          });
        }

        var copyBtn = a.querySelector('.nav-card-copy-btn');
        if (copyBtn) {
          var doCopy = function(e) {
            e.preventDefault();
            e.stopPropagation();
            var deepLink = window.location.origin + window.location.pathname + '#' + cardId;
            copyToClipboard(deepLink, function() {
              var oldHtml = copyBtn.innerHTML;
              copyBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
              copyBtn.classList.add('is-copied');
              setTimeout(function() {
                copyBtn.innerHTML = oldHtml;
                copyBtn.classList.remove('is-copied');
              }, 1600);
              showNavToast('✓ 直达链接已复制到剪贴板');
              history.replaceState(null, '', '#' + cardId);
              a.classList.remove('card-anchor-highlight');
              void a.offsetWidth;
              a.classList.add('card-anchor-highlight');
              setTimeout(function() { a.classList.remove('card-anchor-highlight'); }, 3000);
            });
          };

          copyBtn.addEventListener('click', doCopy);
          copyBtn.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              doCopy(e);
            }
          });
        }

        attach3DTilt(a, 6);
        return a;
      }

      function appendBatch() {
        if (renderedCount >= filteredItems.length) {
          loadMoreWrap.style.display = 'none';
          return;
        }

        var nextBatch = filteredItems.slice(renderedCount, renderedCount + BATCH_SIZE);
        var fragment = document.createDocumentFragment();
        for (var i = 0; i < nextBatch.length; i++) {
          fragment.appendChild(renderCard(nextBatch[i], renderedCount + i));
        }
        cardGrid.appendChild(fragment);
        renderedCount += nextBatch.length;

        if (typeof window.applyNavCustomFeeds === 'function') {
          window.applyNavCustomFeeds();
        }
        if (typeof window.refreshNavFeedCardBadges === 'function') {
          window.refreshNavFeedCardBadges();
        }
        if (typeof window.scheduleNavFeedPrefetch === 'function') {
          window.scheduleNavFeedPrefetch();
        }

        var remaining = filteredItems.length - renderedCount;
        if (remaining > 0) {
          loadMoreWrap.style.display = 'block';
          if (remainingEl) remainingEl.textContent = '(剩余 ' + remaining + ' 个)';
        } else {
          loadMoreWrap.style.display = 'none';
        }
      }

      function updateDynamicBadges() {
        // Dynamic counts for languages
        var langCounts = { all: 0 };
        var langBadges = document.querySelectorAll('[data-lang-badge]');
        for (var i = 0; i < allItems.length; i++) {
          var it = allItems[i];
          var matchSub = (currentSub === 'all' || it.subcategory === currentSub);
          var matchQ = !currentQuery || (it.title + ' ' + it.repo + ' ' + (it.description || '')).toLowerCase().indexOf(currentQuery) !== -1;
          if (matchSub && matchQ) {
            langCounts.all++;
            if (it.language) {
              langCounts[it.language] = (langCounts[it.language] || 0) + 1;
            }
          }
        }

        var cLangAll = document.getElementById('count-lang-all');
        if (cLangAll) cLangAll.textContent = langCounts.all;
        langBadges.forEach(function(badge) {
          var l = badge.getAttribute('data-lang-badge');
          badge.textContent = langCounts[l] || 0;
        });

        // Dynamic counts for subcategories
        var subCounts = { all: 0 };
        var subBadges = document.querySelectorAll('[data-sub-badge]');
        for (var j = 0; j < allItems.length; j++) {
          var item = allItems[j];
          var matchLang = (currentLang === 'all' || item.language === currentLang);
          var matchQry = !currentQuery || (item.title + ' ' + item.repo + ' ' + (item.description || '')).toLowerCase().indexOf(currentQuery) !== -1;
          if (matchLang && matchQry) {
            subCounts.all++;
            if (item.subcategory) {
              subCounts[item.subcategory] = (subCounts[item.subcategory] || 0) + 1;
            }
          }
        }

        var cSubAll = document.getElementById('count-sub-all');
        if (cSubAll) cSubAll.textContent = subCounts.all;
        subBadges.forEach(function(badge) {
          var s = badge.getAttribute('data-sub-badge');
          badge.textContent = subCounts[s] || 0;
        });
      }

      function applyFilters(shouldSyncUrl) {
        var q = currentQuery.trim().toLowerCase();

        filteredItems = allItems.filter(function(item) {
          var matchesLang = (currentLang === 'all' || item.language === currentLang);
          var matchesSub = (currentSub === 'all' || item.subcategory === currentSub);
          var text = (item.title + ' ' + item.repo + ' ' + (item.description || '') + ' ' + (item.tags ? item.tags.join(' ') : '')).toLowerCase();
          var matchesQuery = !q || text.indexOf(q) !== -1;
          return matchesLang && matchesSub && matchesQuery;
        });

        if (currentSort === 'stars') {
          filteredItems.sort(function(a, b) { return (b.stars || 0) - (a.stars || 0); });
        } else if (currentSort === 'forks') {
          filteredItems.sort(function(a, b) { return (b.forks || 0) - (a.forks || 0); });
        } else if (currentSort === 'title') {
          filteredItems.sort(function(a, b) { return (a.title || a.repo).localeCompare(b.title || b.repo); });
        }

        if (filteredCountEl) filteredCountEl.textContent = filteredItems.length;
        updateDynamicBadges();

        if (q) {
          if (queryTag) queryTag.style.display = 'inline-flex';
          if (queryText) queryText.textContent = q;
        } else {
          if (queryTag) queryTag.style.display = 'none';
        }

        var isModified = (currentLang !== 'all' || currentSub !== 'all' || !!q || currentSort !== 'stars');
        if (resetBtn) resetBtn.style.display = isModified ? 'inline-block' : 'none';

        cardGrid.innerHTML = '';
        renderedCount = 0;

        if (filteredItems.length === 0) {
          emptyState.style.display = 'block';
          loadMoreWrap.style.display = 'none';

          if (fuzzyWrap && fuzzyList) {
            if (currentQuery) {
              var suggestions = computeFuzzySuggestions(currentQuery, allItems, 3);
              if (suggestions.length > 0) {
                fuzzyList.innerHTML = '';
                suggestions.forEach(function(title) {
                  var chip = document.createElement('button');
                  chip.type = 'button';
                  chip.className = 'nav-empty-fuzzy-chip';
                  chip.textContent = title;
                  chip.addEventListener('click', function() {
                    currentQuery = title;
                    if (searchInput) searchInput.value = title;
                    applyFilters(true);
                  });
                  fuzzyList.appendChild(chip);
                });
                fuzzyWrap.style.display = 'flex';
              } else {
                fuzzyWrap.style.display = 'none';
              }
            } else {
              fuzzyWrap.style.display = 'none';
            }
          }
        } else {
          emptyState.style.display = 'none';
          if (fuzzyWrap) fuzzyWrap.style.display = 'none';
          appendBatch();
        }

        if (shouldSyncUrl !== false) {
          syncUrlState();
        }
      }

      function syncUrlState() {
        if (!window.history || !window.history.replaceState) return;
        var params = new URLSearchParams();
        if (currentLang !== 'all') params.set('lang', currentLang);
        if (currentSub !== 'all') params.set('sub', currentSub);
        if (currentSort !== 'stars') params.set('sort', currentSort);
        if (currentQuery) params.set('q', currentQuery);

        var qs = params.toString();
        var newUrl = window.location.pathname + (qs ? '?' + qs : '');
        if (newUrl !== window.location.pathname + window.location.search) {
          window.history.replaceState(null, '', newUrl);
        }
      }

      function restoreStateFromUrl() {
        var params = new URLSearchParams(window.location.search);
        currentLang = params.get('lang') || 'all';
        currentSub = params.get('sub') || 'all';
        currentSort = params.get('sort') || 'stars';
        currentQuery = params.get('q') || '';

        if (searchInput) searchInput.value = currentQuery;
        if (sortSelect) sortSelect.value = currentSort;

        langButtons.forEach(function(btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-lang') === currentLang);
        });

        subcatButtons.forEach(function(btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-sub') === currentSub);
        });

        applyFilters(false);
      }

      langButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var l = btn.getAttribute('data-lang');
          if (l === currentLang) return;
          langButtons.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          currentLang = l;
          applyFilters(true);
        });
      });

      subcatButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var s = btn.getAttribute('data-sub');
          if (s === currentSub) return;
          subcatButtons.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          currentSub = s;
          applyFilters(true);
        });
      });

      if (searchInput) {
        var debounceTimer = null;
        searchInput.addEventListener('input', function() {
          currentQuery = searchInput.value;
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            applyFilters(true);
          }, 150);
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          currentSort = sortSelect.value;
          applyFilters(true);
        });
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          appendBatch();
        });
      }

      function resetAll() {
        currentLang = 'all';
        currentSub = 'all';
        currentQuery = '';
        currentSort = 'stars';
        if (searchInput) searchInput.value = '';
        if (sortSelect) sortSelect.value = 'stars';

        langButtons.forEach(function(b) { b.classList.toggle('is-active', b.getAttribute('data-lang') === 'all'); });
        subcatButtons.forEach(function(b) { b.classList.toggle('is-active', b.getAttribute('data-sub') === 'all'); });

        applyFilters(true);
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
      if (clearQueryBtn) {
        clearQueryBtn.addEventListener('click', function() {
          currentQuery = '';
          if (searchInput) searchInput.value = '';
          applyFilters(true);
        });
      }

      if ('IntersectionObserver' in window && sentinel) {
        var observer = new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting && renderedCount < filteredItems.length) {
            appendBatch();
          }
        }, { rootMargin: '400px 0px' });
        observer.observe(sentinel);
      }

      window.addEventListener('popstate', restoreStateFromUrl);

      if (btnShuffleSpotlight) {
        btnShuffleSpotlight.addEventListener('click', function(e) {
          triggerClickSpark(e, 8, '#38bdf8');
          pickSpotlightGithub();
        });
      }

      var heroSpotlightCard = document.getElementById('hero-spotlight-card');
      if (heroSpotlightCard) {
        attach3DTilt(heroSpotlightCard, 5);
        heroSpotlightCard.addEventListener('mousemove', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
        heroSpotlightCard.addEventListener('mouseenter', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
      }

      if (cardGrid) {
        cardGrid.addEventListener('mousemove', function(e) {
          var card = e.target.closest('.nav-card');
          if (card) updateCardGlow(card, e);
        });
      }

      var cmdTriggerBadge = document.querySelector('.nav-key-shortcut');
      if (cmdTriggerBadge) {
        cmdTriggerBadge.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      var cmdSearchIcon = document.querySelector('.nav-search-icon');
      if (cmdSearchIcon) {
        cmdSearchIcon.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      function appendUntilTarget(targetId) {
        var targetIdx = -1;
        for (var i = 0; i < filteredItems.length; i++) {
          var it = filteredItems[i];
          if ((it.id && it.id === targetId) || ('gh-' + it.name) === targetId) {
            targetIdx = i;
            break;
          }
        }
        if (targetIdx >= 0) {
          while (renderedCount <= targetIdx && renderedCount < filteredItems.length) {
            appendBatch();
          }
        }
      }

      function handleHashDeepLink() {
        var hash = window.location.hash;
        if (!hash || hash.length <= 1) return;
        var targetId = decodeURIComponent(hash.slice(1));

        appendUntilTarget(targetId);

        var el = document.getElementById(targetId);
        if (el) {
          setTimeout(function() {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.remove('card-anchor-highlight');
            void el.offsetWidth;
            el.classList.add('card-anchor-highlight');
            setTimeout(function() { el.classList.remove('card-anchor-highlight'); }, 3000);
          }, 150);
        }
      }

      window.addEventListener('hashchange', handleHashDeepLink);

      // Initialize
      restoreStateFromUrl();
      pickSpotlightGithub();
      setTimeout(handleHashDeepLink, 350);

      function syncGithubPinButtons(favList) {
        var favs = favList;
        if (!favs) {
          if (typeof window.getNavFavorites === 'function') {
            favs = window.getNavFavorites();
          } else {
            try {
              var raw = localStorage.getItem('xiu_nav_user_favorites');
              favs = raw ? JSON.parse(raw) : [];
            } catch (e) {
              favs = [];
            }
          }
        }
        var favSet = new Set((favs || []).map(function(x) { return x.id; }));
        document.querySelectorAll('.nav-card-pin-btn').forEach(function(btn) {
          var id = btn.getAttribute('data-id');
          if (favSet.has(id)) {
            btn.classList.add('is-pinned');
            btn.setAttribute('title', '从常用中移除');
          } else {
            btn.classList.remove('is-pinned');
            btn.setAttribute('title', '收藏至我的常用');
          }
        });
      }

      window.addEventListener('nav-favorites-updated', function(e) {
        syncGithubPinButtons(e.detail && e.detail.favorites);
      });

      window.addEventListener('nav-favorites-ready', function(e) {
        syncGithubPinButtons(e.detail && e.detail.favorites);
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { syncGithubPinButtons(); });
      } else {
        syncGithubPinButtons();
      }
    })();
  </script>
</NavLayout>

---
import NavLayout from '../layouts/NavLayout.astro';
import {
  navCategories,
  navWebsites,
  navGithubs,
  navTelegrams,
  navCreators,
  getFeaturedNavItems,
  getAllNavItems,
  isRecentItem,
  sortNavItemsByFreshness
} from '../utils/nav';

const allItems = getAllNavItems();
const featuredItems = getFeaturedNavItems();

// 2 rows x 4 columns = 8 hot / latest cards for homepage core sections
const homeFeatured = featuredItems.slice(0, 8);
const homeTools = sortNavItemsByFreshness(navWebsites).slice(0, 8);
const homeGithubs = [...navGithubs].sort((a, b) => (b.stars || 0) - (a.stars || 0)).slice(0, 8);
const homeTelegrams = [...navTelegrams].sort((a, b) => (b.member_count || 0) - (a.member_count || 0)).slice(0, 8);
const homeCreators = [...navCreators].sort((a, b) => (b.followers_count || 0) - (a.followers_count || 0)).slice(0, 8);

function formatNumber(num?: number): string {
  if (!num) return '';
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
  return String(num);
}

// 12 Vibrant Neon Colors pool (Ported 1:1 from Gallery)
const VIBRANT_ACCENTS = [
  '244, 63, 94',   // Rose
  '236, 72, 153',  // Pink
  '217, 70, 239',  // Fuchsia
  '168, 85, 247',  // Purple
  '129, 140, 248',  // Indigo
  '14, 165, 233',   // Sky Blue
  '20, 184, 166',   // Teal
  '16, 185, 129',   // Emerald
  '132, 204, 22',   // Lime
  '245, 158, 11',   // Amber
  '249, 115, 22',   // Orange
  '239, 68, 68'     // Red
];

function getCardAccent(key: string): string {
  let hash = 0;
  const str = String(key || 'item');
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return VIBRANT_ACCENTS[Math.abs(hash) % VIBRANT_ACCENTS.length];
}

const navJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://sparknav.example.com/#website",
      "name": "SparkNav · 极客智汇导航与开源矩阵",
      "url": "/",
      "description": "全网优质资源精选导航：深度收录优质工具网站、GitHub开源高星项目、Telegram精选频道机器人及全球技术创作者。",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "/search.html?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SiteNavigationElement",
      "name": "SparkNav 核心专区",
      "hasPart": navCategories.map(cat => ({
        "@type": "WebPage",
        "name": cat.name,
        "description": cat.description || `${cat.name}专区`,
        "url": `/category/${cat.id}.html`
      }))
    }
  ]
};
---
<NavLayout title="SparkNav · 极客智汇导航与开源矩阵" jsonLd={navJsonLd}>
  <div class="nav-app">
    <!-- Top Sticky Header -->
    <header class="nav-header">
      <div class="nav-header-inner">
        <!-- Brand & Navigation -->
        <div class="nav-brand-group">
          <a href="/" class="nav-brand-title">
            <span>⚡ SparkNav</span>
            <span class="nav-brand-badge">OSS</span>
          </a>
        </div>

        <!-- Top Vertical Menu -->
        <nav class="nav-header-menu" aria-label="垂直专区导航">
          <a href="/" class="nav-menu-link is-active" title="精选总览首页">
            <span>🧭 精选总览</span>
          </a>
          <a href="/github.html" class="nav-menu-link" title="开源矩阵专区">
            <span>💻 开源矩阵</span>
          </a>
          <a href="/telegram.html" class="nav-menu-link" title="电报生态专区">
            <span>✈️ 电报生态</span>
          </a>
          <a href="/category/tools.html" class="nav-menu-link" title="实用工具专区">
            <span>🛠️ 实用工具</span>
          </a>
          <a href="/category/creators.html" class="nav-menu-link" title="优质博主专区">
            <span>👤 优质博主</span>
          </a>
          
        </nav>

        <!-- Right Controls -->
        <div class="nav-actions">
          <button class="btn-lucky-nav" id="btn-lucky-nav" title="随机探索一个神站 (快捷键: R)">
            <span class="lucky-dice-icon" id="nav-dice-icon">🎲</span>
            <span>随机探索</span>
          </button>
          <span style="font-size: 12px; color: var(--nav-text-muted); font-weight: 600;">
            共收录 <strong style="color: var(--nav-accent);">{allItems.length}</strong> 资源
          </span>
          <button class="theme-toggle-btn" id="nav-theme-btn" title="切换主题 (Light / OLED)">
            <svg id="nav-sun-icon" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg id="nav-moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- TGNAV Single Column Main Layout -->
    <main class="nav-home-tgnav" id="nav-main-content">
      <!-- TGNAV Hero Search Section -->
      <section class="tgnav-hero">
        <div class="tgnav-hero-eyebrow">
          <span>🧭 XIU NAVIGATION PORTAL</span>
        </div>
        <h1 class="tgnav-hero-title">
          <span class="shiny-text">发现全网极客神器与精选资源</span>
        </h1>
        <p class="tgnav-hero-desc">收录全球高星开源项目、Telegram 生态社群、全栈开发工具与全球独立创作者，毫秒级快速索引直达。</p>

        <!-- Big Hero Search Box -->
        <div class="tgnav-search-wrap">
          <div class="tgnav-search-box-container">
            <div class="tgnav-search-box">
              <svg class="tgnav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" id="nav-search-input" class="tgnav-search-input" placeholder="输入关键词即时检索资源、开源项目、电报群组..." autocomplete="off" spellcheck="false" />
              <div class="tgnav-search-tools">
                <button type="button" class="tgnav-search-clear" id="tgnav-search-clear" style="display: none;" title="清空搜索内容">&times;</button>
                <kbd class="tgnav-search-kbd" id="nav-search-shortcut-badge" title="按 ⌘K 或 / 唤起全局检索">⌘K / /</kbd>
              </div>
            </div>

            <!-- Instant Search Dropdown Popover (Option A) -->
            <div class="tgnav-search-popover" id="tgnav-search-popover" style="display: none;" role="listbox" aria-label="搜索即时建议">
              <div class="tgnav-popover-header">
                <span class="tgnav-popover-count" id="tgnav-popover-count">找到 0 项建议</span>
                <span class="tgnav-popover-hint"><kbd>↑</kbd><kbd>↓</kbd> 切换 • <kbd>↵</kbd> 直达 • <kbd>ESC</kbd> 关闭</span>
              </div>
              <div class="tgnav-popover-list" id="tgnav-popover-list">
                <!-- Rendered dynamically -->
              </div>
              <div class="tgnav-popover-footer" id="tgnav-popover-footer">
                <button type="button" class="tgnav-popover-more-btn" id="tgnav-popover-more-btn">
                  <span>⚡ 深度检索全站结果与高级分面 (<span id="tgnav-popover-total">0</span>)</span>
                  <kbd class="tgnav-popover-kbd">⌘K</kbd>
                </button>
              </div>
            </div>
          </div>

          <!-- Hot Quick Chips (TGNAV Style) -->
          <div class="tgnav-quick-chips">
            <span class="tgnav-chip-label">快捷通道:</span>
            <a href="#sec-featured" class="tgnav-chip">🌟 常用精选</a>
            <a href="/github.html" class="tgnav-chip">💻 开源矩阵</a>
            <a href="/telegram.html" class="tgnav-chip">✈️ 电报生态</a>
            <a href="/category/tools.html" class="tgnav-chip">🛠️ 实用工具</a>
            
          </div>
        </div>
      </section>
        <!-- 0. 我的常用收藏 Section (Dynamic Client Rendered) -->
        <section class="nav-section nav-favorites-section" id="sec-user-favorites" style="display: none;">
          <div class="nav-section-head">
            <div class="nav-section-title-wrap">
              <span class="nav-section-icon">⭐</span>
              <h2 class="nav-section-title">我的常用收藏</h2>
              <span class="nav-section-desc">本地持久化快捷置顶，随时一键直达</span>
            </div>
            <div class="nav-favorites-header-actions">
              <span class="nav-badge" id="favorites-badge-count" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; font-weight: 700;">0 项</span>
              <button type="button" class="btn-fav-action" id="btn-export-favorites" title="导出收藏为 JSON 备份">📥 导出 JSON</button>
              <button type="button" class="btn-fav-action" id="btn-export-bookmarks-html" title="导出为标准浏览器书签 HTML (可导入 Chrome / Edge / Safari / Firefox)">🔖 导出书签</button>
              <button type="button" class="btn-fav-action" id="btn-export-opml" title="导出为标准 OPML 订阅源 (可导入 Inoreader / Feedly / NetNewsWire)">📰 导出 OPML</button>
              <button type="button" class="btn-fav-action" id="btn-import-favorites" title="从 JSON、浏览器书签 HTML 或 OPML 订阅源导入恢复">📤 导入</button>
              <input type="file" id="input-import-favorites" accept=".json,.html,.htm,.opml,.xml,application/json,text/html,application/xml,text/xml" style="display: none;" />
              <button type="button" class="btn-clear-favorites" id="btn-clear-all-favorites">清空常用</button>
            </div>
          </div>
          <div class="nav-grid" id="nav-favorites-grid"></div>
        </section>

        <!-- 1. 常用精选 Section -->
        <section class="nav-section" id="sec-featured">
          <div class="nav-section-head">
            <div class="nav-section-title-wrap">
              <span class="nav-section-icon">🌟</span>
              <h2 class="nav-section-title">常用精选</h2>
              <span class="nav-section-desc">核心高频工具与高星开源矩阵</span>
            </div>
            <span class="nav-badge badge-featured">精选 {homeFeatured.length} 项</span>
          </div>

          <div class="nav-grid">
            {homeFeatured.map(item => {
              const accentRgb = getCardAccent(item.id || item.title);
              const itemFeedUrl = item.feed_url || (item.item_type === 'github' && item.repo ? `https://github.com/${item.repo}/releases.atom` : undefined);
              return (
                <a
                  id={item.id}
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`nav-card ${item.is_alive === false ? 'is-offline' : ''}`}
                  style={`--card-accent-rgb: ${accentRgb}; --card-accent: rgb(${accentRgb});`}
                  data-keywords={`${item.title} ${item.description} ${item.tags.join(' ')} ${item.url}`}
                  data-id={item.id}
                  data-title={item.title}
                  data-url={item.url}
                  data-is-alive={item.is_alive === false ? 'false' : 'true'}
                  data-mirrors={item.mirror_urls && item.mirror_urls.length > 0 ? item.mirror_urls.join(',') : undefined}
                  data-feed-url={itemFeedUrl}
                >
                  <div>
                    <div class="nav-card-header">
                      {item.item_type === 'github' ? (
                        <div class="nav-card-avatar icon-small" style="background: #181717; color: #fff;">
                          <img
                            src={item.avatar_url || (item.owner ? `https://github.com/${item.owner}.png?size=96` : '')}
                            alt={item.title}
                            loading="lazy"
                            onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';"
                          />
                          <svg style="display: none;" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                        </div>
                      ) : item.item_type === 'telegram' ? (
                        <div class="nav-card-avatar icon-small" style="background: #0088cc; color: #fff;">
                          {item.avatar_url && !item.avatar_url.includes('default-avatar') ? (
                            <img
                              src={item.avatar_url}
                              alt={item.title}
                              loading="lazy"
                              onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';"
                            />
                            <svg style="display: none;" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/></svg>
                          ) : (
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/></svg>
                          )}
                        </div>
                      ) : item.item_type === 'creator' ? (
                        <div class="nav-card-avatar icon-small" style="border-radius: 50%;">
                          <img
                            src={item.avatar_url || '/assets/images/avatars/default-avatar.svg'}
                            alt={item.title}
                            loading="lazy"
                            onerror="this.onerror=null;this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display='block';"
                          />
                          <svg style="display: none;" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        </div>
                      ) : (
                        <div class="nav-card-avatar icon-small">
                          <img
                            src={item.icon || 'https://unavatar.io/' + encodeURIComponent(item.url)}
                            alt={item.title}
                            loading="lazy"
                            onerror="this.onerror=null;this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display='block';"
                          />
                          <svg style="display: none;" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                        </div>
                      )}
                      <div class="nav-card-info">
                        <div class="nav-card-title-row">
                          <span class="nav-card-title" title={item.title}>{item.title}</span>
                          {isRecentItem(item.created_at) && (
                            <span class="nav-badge badge-new" title={`新收录 (${item.created_at})`}>NEW</span>
                          )}
                          {item.is_alive === false && (
                            <span class="nav-card-offline-pill" title="该站点当前网络状态受限">⚠️ 状态受限</span>
                          )}
                          <span class={`nav-badge ${item.item_type === 'github' ? 'badge-github' : (item.item_type === 'telegram' ? 'badge-tg' : (item.item_type === 'creator' ? 'badge-creator' : 'badge-featured'))}`}>
                            {item.item_type === 'github' ? '💻 开源' : (item.item_type === 'telegram' ? '✈️ 电报' : (item.item_type === 'creator' ? '👤 博主' : '🌟 精选'))}
                          </span>
                        </div>
                      </div>
                    </div>
                    <p class="nav-card-desc">{item.description}</p>
                  </div>
                  <div class="nav-card-footer">
                    <div class="nav-card-tags">
                      {item.tags.slice(0, 2).map(tag => (
                        <span class="nav-tag-pill">{tag}</span>
                      ))}
                    </div>
                    <div class="nav-card-stat">
                      {item.item_type === 'github' && <span>⭐ {formatNumber(item.stars)}</span>}
                      {item.item_type === 'telegram' && <span>👥 {formatNumber(item.member_count)}</span>}
                      {item.item_type === 'creator' && <span>🔥 {formatNumber(item.followers_count)}</span>}
                      {item.item_type === 'website' && <span class="nav-card-action">直达 &rarr;</span>}
                      <div class="nav-card-actions-group">
                        {itemFeedUrl && (
                          <button type="button" class="nav-card-feed-btn" title="查看最新动态 (RSS/Atom)" data-feed-url={itemFeedUrl} data-title={item.title}>
                            <svg viewBox="0 0 24 24"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
                          </button>
                        )}
                        <button type="button" class="nav-card-pin-btn" title="收藏至我的常用" data-id={item.id}>
                          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </button>
                        <button type="button" class="nav-card-copy-btn" title="复制卡片直达链接" data-id={item.id}>
                          <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <!-- 2. 实用工具 Section -->
        <section class="nav-section" id="sec-tools" style="--sec-accent: #f59e0b; --sec-accent-rgb: 245, 158, 11;">
          <div class="nav-section-head">
            <div class="nav-section-title-wrap">
              <span class="nav-section-icon">🛠️</span>
              <h2 class="nav-section-title">实用工具</h2>
              <span class="nav-section-desc">AI 应用、全平台客户端、开发运维与网络神器</span>
            </div>
            <div class="nav-head-actions">
              <a href="/category/tools.html" class="nav-hub-quick-link" style="color: #fbbf24; border-color: rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.1);" title="进入实用工具独立专区大厅">
                进入完整工具箱 (共 {navWebsites.length} 款) &rarr;
              </a>
            </div>
          </div>

          <div class="nav-grid">
            {homeTools.map(item => {

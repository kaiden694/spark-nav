---
import NavLayout from '../../layouts/NavLayout.astro';
import {
  navCategories,
  navWebsites,
  navGithubs,
  navTelegrams,
  navCreators,
  getFeaturedNavItems,
  getAllNavItems
} from '../../utils/nav';
import type { NavCategory, AnyNavItem } from '../../types/nav';

export async function getStaticPaths() {
  return navCategories.map(cat => {
    let items: AnyNavItem[] = [];
    if (cat.id === 'tools') {
      items = navWebsites.map(w => ({ ...w, item_type: 'website' as const }));
    } else if (cat.id === 'github') {
      items = navGithubs.map(g => ({ ...g, item_type: 'github' as const }));
    } else if (cat.id === 'telegram') {
      items = navTelegrams.map(t => ({ ...t, item_type: 'telegram' as const }));
    } else if (cat.id === 'creators') {
      items = navCreators.map(c => ({ ...c, item_type: 'creator' as const }));
    } else if (cat.id === 'featured') {
      items = getFeaturedNavItems();
    } else {
      items = getAllNavItems().filter(i => i.category === cat.id);
    }
    return {
      params: { category: cat.id },
      props: { category: cat, items }
    };
  });
}

interface Props {
  category: NavCategory;
  items: AnyNavItem[];
}

const { category, items } = Astro.props;
const totalCount = items.length;
const subcategories = category.subcategories || [];



const clientItemsJson = JSON.stringify(items);

const categoryJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "导航总览",
          "item": "/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": category.name,
          "item": `/category/${category.id}.html`
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `https://sparknav.example.com/category/${category.id}.html#webpage`,
      "name": `${category.name} · XIU神站导航`,
      "description": `XIU神站导航${category.name}独立子路由大厅：深度收录${category.name}优质项目与资源。`,
      "url": `/category/${category.id}.html`,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": totalCount,
        "itemListElement": items.slice(0, 50).map((it, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "name": it.title,
          "description": it.description || it.title,
          "url": it.url
        }))
      }
    }
  ]
};
---
<NavLayout
  title={`${category.name} · ${category.description || '神站导航独立子大厅'} · XIU神站导航`}
  description={`XIU神站导航${category.name}独立子路由大厅：深度收录${category.name}优质项目与资源，支持毫秒级检索与多维筛选。`}
  canonical={`/category/${category.id}.html`}
  jsonLd={categoryJsonLd}
>
  <div class="nav-app">
    <!-- Top Sticky Header -->
    <header class="nav-header">
      <div class="nav-header-inner">
        <!-- Brand & Breadcrumbs -->
        <div class="nav-brand-group">
          <a href="/" class="btn-nav-back" title="返回首页大厅">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <span>导航总览</span>
          </a>
          <a href={`/category/${category.id}.html`} class="nav-brand-title">
            <span>{category.icon} {category.name}</span>
            <span class="nav-brand-badge">Subroute</span>
          </a>
        </div>

        <!-- Top Vertical Menu -->
        <nav class="nav-header-menu" aria-label="垂直专区导航">
          <a href="/" class="nav-menu-link" title="精选总览首页">
            <span>🧭 精选总览</span>
          </a>
          <a href="/github.html" class="nav-menu-link" title="开源矩阵专区">
            <span>💻 开源矩阵</span>
          </a>
          <a href="/telegram.html" class="nav-menu-link" title="电报生态专区">
            <span>✈️ 电报生态</span>
          </a>
          <a href="/category/tools.html" class={`nav-menu-link ${category.id === 'tools' ? 'is-active' : ''}`} title="实用工具专区">
            <span>🛠️ 实用工具</span>
          </a>
          <a href="/category/creators.html" class={`nav-menu-link ${category.id === 'creators' ? 'is-active' : ''}`} title="优质博主专区">
            <span>👤 优质博主</span>
          </a>
          
        </nav>

        <!-- Global Search Bar with Cmd+K Trigger -->
        <div class="nav-search-wrap">
          <div class="nav-search-box" id="header-cmd-k-trigger" style="cursor: pointer;" title="点击或按快捷键唤醒全局命令搜索中心">
            <svg class="nav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="cat-local-search-input" class="nav-search-input" placeholder={`在 ${category.name} 专区内即时搜索...`} autocomplete="off" spellcheck="false" />
            <kbd class="nav-key-shortcut" title="按 Cmd+K 或 / 唤出全局检索">⌘K</kbd>
          </div>
        </div>

        <!-- Right Controls -->
        <div class="nav-actions">
          <span style="font-size: 12px; color: var(--nav-text-muted); font-weight: 600;">
            收录 <strong style="color: var(--nav-accent);">{totalCount}</strong> 项资源
          </span>
          <button class="theme-toggle-btn" id="nav-theme-btn" title="切换主题 (Light / OLED)">
            <svg id="nav-sun-icon" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg id="nav-moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <div class="cat-hub-container">
      <!-- Dual-Wing Enhanced Hero Section (Parity with Telegram & GitHub) -->
      <section class="thematic-hero-section">
        <div class="thematic-hero-grid">
          <!-- Left Wing: Value Prop & Stats Capsules -->
          <div class="thematic-hero-left">
            <div>
              <div class="thematic-hero-eyebrow">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>{(category.id === 'tools' ? 'UTILITY TOOLS' : (category.id ? category.id.toUpperCase() : category.name.toUpperCase()))} ECOSYSTEM MATRIX</span>
              </div>
              <h1 class="thematic-hero-title">
                <span class="shiny-text">{category.name}独立大厅</span>
              </h1>
              <p class="thematic-hero-desc">
                {category.description || '高频访问的核心工具、神器与日常必备入口，采用独立 SSG 子路由切片架构，杜绝长列表渲染卡顿。'}
              </p>
            </div>

            <!-- Unified Glass Capsule Strip -->
            <div class="hero-unified-capsule">
              <div class="capsule-metric-item">
                <div class="capsule-icon icon-wrap-blue">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="capsule-data">
                  <span class="capsule-number" id="stat-total-chip">{totalCount}</span>
                  <span class="capsule-label">收录总数</span>
                </div>
              </div>

              <div class="capsule-divider"></div>

              <div class="capsule-metric-item">
                <div class="capsule-icon icon-wrap-purple">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </div>
                <div class="capsule-data">
                  <span class="capsule-number">{subcategories.length}</span>
                  <span class="capsule-label">细分类目</span>
                </div>
              </div>

              <div class="capsule-divider"></div>

              <div class="capsule-metric-item">
                <div class="capsule-icon icon-wrap-gold">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="capsule-data">
                  <span class="capsule-number">100%</span>
                  <span class="capsule-label">静态切片</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Wing: Spotlight Feature Card (Parity with Telegram & GitHub) -->
          <div class="hero-right-spotlight" id="hero-spotlight-card">
            <div class="spotlight-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <span class="shiny-gold">今日精选 Spotlight</span>
            </div>
            
            <div class="spotlight-body" id="spotlight-dynamic-content">
              <div class="spotlight-loading" style="color: var(--nav-text-muted); font-size: 13px;">正在挑选今日精选资源...</div>
            </div>

            <button class="btn-shuffle-spotlight" id="btn-shuffle-spotlight" title="换一个精选推荐">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
              <span>换一位推荐</span>
            </button>
          </div>
        </div>
      </section>

      <!-- Specialized Pro Hub Notice (For GitHub / Telegram) -->
      {category.id === 'github' && (
        <div class="cat-pro-callout">
          <div class="cat-pro-callout-left">
            <span class="cat-pro-callout-icon">💻</span>
            <div>
              <div class="cat-pro-callout-title">GitHub 极客矩阵专属大厅已就绪</div>
              <div class="cat-pro-callout-desc">专属大厅支持多语言正交筛选、Star/Fork实时雷达图分析与高星开源排行榜。</div>
            </div>
          </div>
          <a href="/github.html" class="cat-pro-callout-btn">
            <span>进入开源专属大厅</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      )}

      {category.id === 'telegram' && (
        <div class="cat-pro-callout">
          <div class="cat-pro-callout-left">
            <span class="cat-pro-callout-icon">✈️</span>
            <div>
              <div class="cat-pro-callout-title">Telegram 中文高品质资源大厅已就绪</div>
              <div class="cat-pro-callout-desc">专属大厅支持成员数阶梯分布过滤、频道/群组/Bot形态筛选与防诈探活机制。</div>
            </div>
          </div>
          <a href="/telegram.html" class="cat-pro-callout-btn">
            <span>进入电报专属大厅</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      )}

      <!-- Vertical Layout: Dynamic Left Sidebar + Right Main Workspace -->
      <div class="vertical-layout">
        <!-- Left Dynamic Sidebar -->
        <aside class="vertical-sidebar" id="vertical-sidebar">
          {subcategories.length > 0 && (
            <div class="vertical-sidebar-section">
              <div class="vertical-sidebar-title">
                <span>🏷️ 细分类目</span>
                <span class="vertical-sidebar-badge">{subcategories.length}</span>
              </div>
              <ul class="vertical-sidebar-menu" id="cat-subcat-filter-group">
                <li>
                  <button type="button" class="vertical-sidebar-item is-active" data-sub="all">
                    <span class="vertical-sidebar-item-left">
                      <span>⚡</span>
                      <span>全部分类</span>
                    </span>
                    <span class="vertical-sidebar-badge" id="count-sub-all">{totalCount}</span>
                  </button>
                </li>
                {subcategories.map(sub => {
                  const count = items.filter(it => it.subcategory === sub.id).length;
                  return (
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-sub={sub.id}>
                        <span class="vertical-sidebar-item-left">
                          <span>{sub.icon || '🏷️'}</span>
                          <span>{sub.name}</span>
                        </span>
                        <span class="vertical-sidebar-badge" data-sub-badge={sub.id}>{count}</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <!-- Type filter inside sidebar if applicable -->
          {(category.id === 'tools' || category.id === 'creators' || category.id === 'telegram') && (
            <div class="vertical-sidebar-section">
              <div class="vertical-sidebar-title">
                <span>🎯 筛选属性</span>
              </div>
              <ul class="vertical-sidebar-menu" id="cat-type-filter-group">
                <li>
                  <button type="button" class="vertical-sidebar-item is-active" data-type="all">
                    <span class="vertical-sidebar-item-left">
                      <span>🌐</span>
                      <span>全部类型</span>
                    </span>
                  </button>
                </li>
                {category.id === 'tools' && (
                  <>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="free">
                        <span class="vertical-sidebar-item-left">
                          <span>✨</span>
                          <span>免费工具</span>
                        </span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="freemium">
                        <span class="vertical-sidebar-item-left">
                          <span>⚡</span>
                          <span>免费试用</span>
                        </span>
                      </button>
                    </li>
                  </>
                )}
                {category.id === 'creators' && (
                  <>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="x">
                        <span class="vertical-sidebar-item-left">
                          <span>𝕏</span>
                          <span>𝕏 (Twitter)</span>
                        </span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="youtube">
                        <span class="vertical-sidebar-item-left">
                          <span>📺</span>
                          <span>YouTube</span>
                        </span>
                      </button>
                    </li>
                  </>
                )}
                {category.id === 'telegram' && (
                  <>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="channel">
                        <span class="vertical-sidebar-item-left">
                          <span>📢</span>
                          <span>优质频道</span>
                        </span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="bot">
                        <span class="vertical-sidebar-item-left">
                          <span>🤖</span>
                          <span>实用机器人</span>
                        </span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="vertical-sidebar-item" data-type="group">
                        <span class="vertical-sidebar-item-left">
                          <span>👥</span>
                          <span>极客群组</span>
                        </span>
                      </button>
                    </li>
                  </>
                )}
              </ul>
            </div>
          )}

          <!-- Section 3: 全站专区直达 -->
          <div class="vertical-sidebar-section">
            <div class="vertical-sidebar-title">
              <span>🧭 专区直达</span>
            </div>
            <ul class="vertical-sidebar-menu">
              <li>
                <a href="/" class="vertical-sidebar-item">
                  <span class="vertical-sidebar-item-left">
                    <span>🧭</span>
                    <span>导航首页</span>
                  </span>
                </a>
              </li>
              {navCategories.map(c => {
                const isCurrent = c.id === category.id;
                const targetUrl = (c.id === 'github') ? '/nav/github.html' : (c.id === 'telegram' ? '/nav/telegram.html' : `/category/${c.id}.html`);
                return (
                  <li>
                    <a href={targetUrl} class={`vertical-sidebar-item ${isCurrent ? 'is-active' : ''}`}>
                      <span class="vertical-sidebar-item-left">
                        <span>{c.icon}</span>
                        <span>{c.name}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
              <li>
                
              </li>
            </ul>
          </div>
        </aside>

        <!-- Right Main Workspace -->
        <main class="vertical-main">
          <!-- Compact Status Bar -->
          <div class="vertical-status-bar">
            <div class="vertical-status-left">
              <span>筛选结果：</span>
              <strong id="cat-filtered-count" style="color: var(--nav-accent);">{totalCount}</strong> 项
              <span id="cat-query-tag" class="cat-query-tag" style="display: none;">
                包含关键词: "<span id="cat-query-text"></span>"
                <button type="button" id="cat-clear-query-btn">&times;</button>
              </span>
            </div>
            <div class="vertical-status-right">
              <div class="vertical-sort-wrap">
                <span class="cat-sort-label">排序方式：</span>
                <select id="cat-sort-select" class="vertical-sort-select" aria-label="分类资源排序方式">
                  <option value="default">默认推荐顺序</option>
                  <option value="visits">高频访问</option>
                  <option value="title">名称字母排序</option>
                </select>
              </div>
              <button type="button" id="cat-reset-all-filters" class="cat-reset-btn" style="display: none;">
                重置筛选
              </button>
            </div>
          </div>

      <!-- Card Grid Area -->
      <div class="nav-grid" id="cat-card-grid">
        {Array.from({ length: 8 }).map(() => (
          <div class="nav-card-skeleton" aria-hidden="true">
            <div class="skeleton-header">
              <div class="skeleton-icon"></div>
              <div class="skeleton-title-wrap">
                <div class="skeleton-line skeleton-line-title"></div>
                <div class="skeleton-line" style="width: 40%;"></div>
              </div>
            </div>
            <div class="skeleton-line skeleton-line-desc"></div>
            <div class="skeleton-line skeleton-line-desc-short"></div>
          </div>
        ))}
      </div>

      <!-- Load more Sentinel -->
      <div class="cat-load-more-wrap" id="cat-load-more-wrap" style="display: none;">
        <button type="button" id="cat-load-more-btn" class="cat-load-more-btn">
          <span>加载更多</span>
          <span id="cat-remaining-count" class="cat-remaining-count"></span>
        </button>
        <div id="cat-scroll-sentinel" style="height: 20px; width: 100%;"></div>
      </div>

      <!-- Empty State -->
      <div id="cat-empty-state" class="nav-empty-grid" style="display: none;">
        <span class="nav-empty-grid-icon">🛸</span>
        <div class="nav-empty-grid-text">当前筛选条件下暂无收录项目</div>
        <div id="cat-empty-fuzzy-wrap" class="nav-empty-fuzzy-wrap" style="display: none;">
          <span class="nav-empty-fuzzy-label">🔍 您是否在找以下热门收录：</span>
          <div id="cat-empty-fuzzy-list" class="nav-empty-fuzzy-list"></div>
        </div>
        <button type="button" class="nav-empty-grid-btn" id="cat-empty-reset-btn">重置所有筛选条件</button>
      </div>
        </main>
      </div>



      <!-- Bottom Cross-Navigation Matrix -->
      <div class="cat-cross-nav-section">
        <div class="cat-cross-nav-header">
          <span class="cat-cross-nav-icon">🧭</span>
          <span class="cat-cross-nav-title">探索更多垂直大厅与专题切片</span>
        </div>
        <div class="cat-cross-nav-grid">
          {navCategories.map(c => {
            const isCurrent = c.id === category.id;
            const targetUrl = (c.id === 'github') ? '/nav/github.html' : (c.id === 'telegram' ? '/nav/telegram.html' : `/category/${c.id}.html`);
            return (
              <a href={targetUrl} class={`cat-cross-card ${isCurrent ? 'is-current' : ''}`}>
                <span class="cat-cross-icon">{c.icon}</span>
                <div class="cat-cross-info">
                  <div class="cat-cross-name">{c.name} {isCurrent && <span class="cat-cross-badge">当前</span>}</div>
                  <div class="cat-cross-desc">{c.description || '精选资源合集'}</div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <script is:inline id="cat-raw-data" type="application/json" set:html={clientItemsJson}></script>
  <script is:inline id="cat-subcategories-data" type="application/json" set:html={JSON.stringify(subcategories)}></script>

  <style>
    .cat-hub-container {
      width: 100%;
      max-width: 1680px;
      margin: 0 auto;
      padding: 24px 20px 80px 20px;
      box-sizing: border-box;
    }


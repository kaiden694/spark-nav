---
// FavoritesCloudSyncModal.astro
// Universal Cross-Device Cloud Sync Engine for XIU Navigation Favorites
// Supports GitHub Gist (zero server, private gist) and WebDAV (Nutstore / Nextcloud / NAS)
// Zero-knowledge & pure client direct communication
---

<div
  id="nav-cloud-sync-modal"
  class="nav-sync-backdrop"
  style="display: none;"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sync-modal-title"
>
  <div class="nav-sync-dialog">
    <!-- Header -->
    <div class="nav-sync-header">
      <div class="nav-sync-title-wrap">
        <span class="nav-sync-icon">☁️</span>
        <div>
          <h3 id="sync-modal-title" class="nav-sync-title">常用收藏 · 跨设备云端同步</h3>
          <p class="nav-sync-subtitle">多设备数据互通 · 纯前端加密直连 · 零服务端中转</p>
        </div>
      </div>
      <button type="button" class="nav-sync-close-btn" id="nav-sync-close-btn" title="关闭 (ESC)">
        <kbd>ESC</kbd>
      </button>
    </div>

    <!-- Provider Tabs -->
    <div class="nav-sync-tabs">
      <button type="button" class="nav-sync-tab is-active" id="tab-btn-gist" data-provider="gist">
        <span>🐙 GitHub Gist (推荐)</span>
      </button>
      <button type="button" class="nav-sync-tab" id="tab-btn-webdav" data-provider="webdav">
        <span>📁 WebDAV (坚果云 / NAS)</span>
      </button>
    </div>

    <!-- Body -->
    <div class="nav-sync-body">
      <!-- 1. GitHub Gist Config Form -->
      <div class="nav-sync-panel" id="panel-gist">
        <div class="nav-sync-form-group">
          <label class="nav-sync-label" for="sync-gist-token">
            <span>GitHub Personal Access Token (PAT)</span>
            <a
              href="https://github.com/settings/tokens/new?scopes=gist&description=XiuNavFavoritesSync"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-sync-help-link"
              title="点击直达 GitHub 生成专用 Token，仅勾选 gist 权限即可"
            >
              获取 Token &rarr;
            </a>
          </label>
          <div class="nav-sync-input-wrap">
            <input
              type="password"
              id="sync-gist-token"
              class="nav-sync-input"
              placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="button" id="btn-toggle-token-mask" class="nav-sync-toggle-mask" title="显示/隐藏 Token">
              👁️
            </button>
          </div>
          <span class="nav-sync-hint">仅需 <strong>gist</strong> 权限。Token 仅加密留存于您当前浏览器的 LocalStorage 中，绝不上报站长服务器。</span>
        </div>

        <div class="nav-sync-form-group">
          <label class="nav-sync-label" for="sync-gist-id">
            <span>Gist ID (首次可留空自动创建)</span>
          </label>
          <input
            type="text"
            id="sync-gist-id"
            class="nav-sync-input"
            placeholder="留空自动新建私有 Gist，或粘贴已有的 Gist ID"
            autocomplete="off"
            spellcheck="false"
          />
          <span class="nav-sync-hint">如需在手机/其他电脑同步，在此输入已创建的 Gist ID 即可拉取。</span>
        </div>
      </div>

      <!-- 2. WebDAV Config Form -->
      <div class="nav-sync-panel" id="panel-webdav" style="display: none;">
        <div class="nav-sync-form-group">
          <label class="nav-sync-label" for="sync-webdav-url">
            <span>WebDAV 服务器地址</span>
          </label>
          <input
            type="text"
            id="sync-webdav-url"
            class="nav-sync-input"
            placeholder="例如: https://dav.jianguoyun.com/dav/"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="nav-sync-form-row">
          <div class="nav-sync-form-group">
            <label class="nav-sync-label" for="sync-webdav-user">用户名 / 邮箱</label>
            <input type="text" id="sync-webdav-user" class="nav-sync-input" placeholder="WebDAV 用户名" />
          </div>
          <div class="nav-sync-form-group">
            <label class="nav-sync-label" for="sync-webdav-pass">应用密码 / Token</label>
            <input type="password" id="sync-webdav-pass" class="nav-sync-input" placeholder="应用授权密码" />
          </div>
        </div>

        <div class="nav-sync-form-group">
          <label class="nav-sync-label" for="sync-webdav-path">文件存储路径</label>
          <input type="text" id="sync-webdav-path" class="nav-sync-input" value="/xiu-nav/favorites.json" />
        </div>
      </div>

      <!-- Common Settings -->
      <div class="nav-sync-switches">
        <label class="nav-sync-checkbox-label">
          <input type="checkbox" id="sync-auto-sync" checked />
          <span>收藏发生变动时，3秒内静默自动同步至云端</span>
        </label>
      </div>

      <!-- Status Bar -->
      <div class="nav-sync-status-bar" id="sync-status-bar">
        <div class="nav-sync-status-left">
          <span class="status-indicator" id="sync-status-dot">●</span>
          <span id="sync-status-text">未进行云端同步</span>
        </div>
        <div class="nav-sync-status-right" id="sync-time-text">上次同步: 从未</div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="nav-sync-footer">
      <div class="nav-sync-footer-left">
        <button type="button" id="btn-sync-clear-config" class="btn-sync-ghost" title="清除保存在本机的 Token 与账号信息">
          清除配置
        </button>
        <button type="button" id="btn-sync-show-qr" class="btn-sync-action btn-sync-qr" title="生成跨端加密配对二维码，手机扫码即可免输密码">
          📱 手机配对
        </button>
      </div>
      <div class="nav-sync-footer-right">
        <button type="button" id="btn-sync-pull" class="btn-sync-action btn-sync-pull" title="以云端最新数据覆盖本地">
          ⬇️ 云端覆盖本地
        </button>
        <button type="button" id="btn-sync-push" class="btn-sync-action btn-sync-push" title="以本地数据覆盖云端">
          ⬆️ 本地覆盖云端
        </button>
        <button type="button" id="btn-sync-merge" class="btn-sync-action btn-sync-primary" title="对比本地与云端，基于时间戳智能合并">
          ⚡ 立即双向合并
        </button>
      </div>
    </div>

    <!-- QR Code Pair Overlay -->
    <div id="nav-sync-qr-overlay" class="nav-sync-qr-overlay" style="display: none;">
      <div class="nav-sync-qr-card">
        <div class="nav-sync-qr-header">
          <div class="nav-sync-qr-title-wrap">
            <span class="qr-title-icon">📱</span>
            <span class="qr-title-text">手机扫码免密配对</span>
          </div>
          <button type="button" id="btn-sync-qr-close" class="nav-sync-qr-close" title="关闭 (ESC)">✕</button>
        </div>
        <p class="nav-sync-qr-desc">使用手机相机或浏览器扫描下方二维码，即可直接导入当前账号配置，免除手动逐字输入长密钥。</p>
        <div class="nav-sync-qr-canvas-box">
          <canvas id="nav-sync-qr-canvas" width="220" height="220"></canvas>
          <div class="nav-sync-qr-loading" id="nav-sync-qr-loading">正在生成离线安全二维码...</div>
        </div>
        <div class="nav-sync-qr-meta">
          <span class="nav-sync-qr-tag" id="nav-sync-qr-provider-tag">GitHub Gist</span>
          <span class="nav-sync-qr-secure-hint">🔒 纯前端离线直接渲染 · 无第三方中转</span>
        </div>
        <button type="button" id="btn-sync-copy-pair-url" class="btn-sync-qr-copy" title="复制包含配对凭据的完整链接">
          📋 复制配对链接
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Incoming Pairing Confirmation Dialog (For Mobile Scanner) -->
<div
  id="nav-sync-incoming-modal"
  class="nav-sync-backdrop"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="incoming-modal-title"
>
  <div class="nav-sync-dialog nav-sync-dialog-incoming">
    <div class="nav-sync-header">
      <div class="nav-sync-title-wrap">
        <span class="nav-sync-icon">📱</span>
        <div>
          <h3 id="incoming-modal-title" class="nav-sync-title">收到跨设备云同步配对请求</h3>
          <p class="nav-sync-subtitle">来自 PC 端生成的加密配置包</p>
        </div>
      </div>
    </div>
    <div class="nav-sync-body">
      <div class="nav-sync-incoming-card">
        <div class="nav-incoming-row">
          <span class="incoming-label">同步渠道:</span>
          <span class="incoming-val" id="incoming-provider-name">GitHub Gist</span>
        </div>
        <div class="nav-incoming-row">
          <span class="incoming-label">授权标识:</span>
          <span class="incoming-val" id="incoming-account-id">ghp_****...</span>
        </div>
        <div class="nav-incoming-row">
          <span class="incoming-label">自动同步:</span>
          <span class="incoming-val" id="incoming-auto-sync">开启 (变动后3秒)</span>
        </div>
      </div>
      <p class="nav-incoming-notice">
        点击“确认导入”后，该配置将安全保存在本机浏览器中，并立即执行双向云端数据合并。
      </p>
    </div>
    <div class="nav-sync-footer">
      <div class="nav-sync-footer-left">
        <button type="button" id="btn-incoming-cancel" class="btn-sync-ghost" title="取消并放弃导入">
          放弃导入
        </button>
      </div>
      <div class="nav-sync-footer-right">
        <button type="button" id="btn-incoming-confirm" class="btn-sync-action btn-sync-primary" title="导入此配置并从云端同步">
          ✓ 确认导入并连接云端
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .nav-sync-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-sync-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-sync-dialog {
    width: 100%;
    max-width: 580px;
    background: rgba(18, 22, 34, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
    transform: scale(0.96) translateY(8px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .nav-sync-backdrop.is-open .nav-sync-dialog {
    transform: scale(1) translateY(0);
  }

  :global([data-theme="light"]) .nav-sync-dialog {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  /* Header */
  .nav-sync-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  :global([data-theme="light"]) .nav-sync-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.01);
  }

  .nav-sync-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-sync-icon {
    font-size: 26px;
    line-height: 1;
  }

  .nav-sync-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--nav-text-main, #ffffff);
  }

  :global([data-theme="light"]) .nav-sync-title {
    color: #0f172a;
  }

  .nav-sync-subtitle {
    margin: 4px 0 0 0;
    font-size: 12px;
    color: var(--nav-text-muted, #94a3b8);
  }

  .nav-sync-close-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--nav-text-muted, #94a3b8);
    padding: 4px 8px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 11px;
    transition: all 0.15s ease;
  }

  .nav-sync-close-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  :global([data-theme="light"]) .nav-sync-close-btn {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
  }

  /* Tabs */
  .nav-sync-tabs {
    display: flex;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 16px 0 16px;
    gap: 8px;
  }

  :global([data-theme="light"]) .nav-sync-tabs {
    background: rgba(0, 0, 0, 0.02);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .nav-sync-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--nav-text-muted, #94a3b8);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .nav-sync-tab:hover {
    color: var(--nav-text-main, #ffffff);
  }

  :global([data-theme="light"]) .nav-sync-tab:hover {
    color: #0f172a;
  }

  .nav-sync-tab.is-active {
    color: #3b82f6;
    border-bottom-color: #3b82f6;
  }

  /* Body */
  .nav-sync-body {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-sync-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-sync-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .nav-sync-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    color: var(--nav-text-sub, #cbd5e1);
  }

  :global([data-theme="light"]) .nav-sync-label {
    color: #334155;
  }

  .nav-sync-help-link {
    color: #3b82f6;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
  }

  .nav-sync-help-link:hover {
    text-decoration: underline;
  }

  .nav-sync-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-sync-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.25);
    color: var(--nav-text-main, #ffffff);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  :global([data-theme="light"]) .nav-sync-input {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.15);
    color: #0f172a;
  }

  .nav-sync-input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }

  .nav-sync-toggle-mask {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .nav-sync-toggle-mask:hover {
    opacity: 1;
  }

  .nav-sync-hint {
    font-size: 11px;
    line-height: 1.4;
    color: var(--nav-text-muted, #94a3b8);
  }

  .nav-sync-switches {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 4px;
  }

  .nav-sync-checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--nav-text-sub, #cbd5e1);
    cursor: pointer;
  }

  :global([data-theme="light"]) .nav-sync-checkbox-label {
    color: #334155;
  }

  /* Status Bar */
  .nav-sync-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    font-size: 12px;
  }

  :global([data-theme="light"]) .nav-sync-status-bar {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.06);
  }

  .nav-sync-status-left {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .status-indicator {
    font-size: 14px;
    color: #94a3b8;
  }

  .status-indicator.ready { color: #10b981; }
  .status-indicator.syncing { color: #3b82f6; animation: pulse 1s infinite; }
  .status-indicator.error { color: #ef4444; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .nav-sync-status-right {
    color: var(--nav-text-muted, #94a3b8);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
  }

  /* Footer */
  .nav-sync-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  :global([data-theme="light"]) .nav-sync-footer {
    border-top-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.01);
  }

  .nav-sync-footer-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-sync-ghost {
    background: none;
    border: none;
    color: #ef4444;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .btn-sync-ghost:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .btn-sync-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 7px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    color: var(--nav-text-sub, #cbd5e1);
    transition: all 0.15s ease;
  }

  :global([data-theme="light"]) .btn-sync-action {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
    color: #334155;
  }

  .btn-sync-action:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: translateY(-1px);
  }

  :global([data-theme="light"]) .btn-sync-action:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #0f172a;
  }

  .btn-sync-primary {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }

  .btn-sync-primary:hover {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.5);
    color: #ffffff;
  }

  .btn-sync-qr {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.3);
    color: #34d399;
  }

  .btn-sync-qr:hover {
    background: rgba(16, 185, 129, 0.22);
    border-color: #10b981;
    color: #ffffff;
  }

  /* QR Pairing Overlay */
  .nav-sync-qr-overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: rgba(10, 14, 23, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    animation: fadeIn 0.18s ease-out;
  }

  :global([data-theme="light"]) .nav-sync-qr-overlay {
    background: rgba(255, 255, 255, 0.96);
  }

  .nav-sync-qr-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 380px;
    gap: 12px;
  }

  .nav-sync-qr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .nav-sync-qr-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--nav-text-main, #ffffff);
  }

  :global([data-theme="light"]) .nav-sync-qr-title-wrap {
    color: #0f172a;
  }

  .nav-sync-qr-close {
    background: none;
    border: none;
    color: var(--nav-text-muted, #94a3b8);

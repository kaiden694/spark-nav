            iconHtml = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/></svg>';
          }
        } else if (item.item_type === 'creator') {
          var crAvatar = item.avatar_url || '/assets/images/avatars/default-avatar.svg';
          iconHtml = '<img src="' + escapeHtml(crAvatar) + '" alt="' + escapeHtml(item.title) + '" ' + imgAttrs + ' onerror="this.onerror=null;this.style.display=\'none\';if(this.nextElementSibling)this.nextElementSibling.style.display=\'block\';" />' +
            '<svg class="nav-card-fallback-icon" style="display: none;" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>';
        } else {
          var webIcon = item.icon || ('https://unavatar.io/' + encodeURIComponent(item.url));
          iconHtml = '<img src="' + escapeHtml(webIcon) + '" alt="' + escapeHtml(item.title) + '" ' + imgAttrs + ' onerror="this.onerror=null;this.style.display=\'none\';if(this.nextElementSibling)this.nextElementSibling.style.display=\'block\';" />' +
            '<svg class="nav-card-fallback-icon" style="display: none;" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>';
        }

        var tagsHtml = '';
        if (Array.isArray(item.tags)) {
          item.tags.slice(0, 2).forEach(function(tag) {
            tagsHtml += '<span class="nav-tag-pill">' + escapeHtml(tag) + '</span>';
          });
        }

        var statHtml = '';
        if (item.stars) statHtml = '⭐ ' + formatFollowers(item.stars);
        else if (item.member_count) statHtml = '👥 ' + formatFollowers(item.member_count);
        else if (item.followers_count) statHtml = '🔥 ' + formatFollowers(item.followers_count);
        else if (item.pricing) statHtml = item.pricing === 'free' ? '免费' : (item.pricing === 'freemium' ? '试用' : item.pricing);
        else statHtml = '直达 &rarr;';

        var badgeLabel = '精选';
        var badgeClass = 'badge-featured';
        if (item.item_type === 'github') { badgeLabel = '💻 开源'; badgeClass = 'badge-github'; }
        else if (item.item_type === 'telegram') { badgeLabel = '✈️ 电报'; badgeClass = 'badge-tg'; }
        else if (item.item_type === 'creator') { badgeLabel = '👤 博主'; badgeClass = 'badge-creator'; }
        else if (item.item_type === 'website') { badgeLabel = '🛠️ 工具'; badgeClass = 'badge-featured'; }

        var isPinned = false;
        if (typeof window.isNavFavorite === 'function') {
          isPinned = window.isNavFavorite(cardId);
        } else {
          try {
            var rawFavs = localStorage.getItem('xiu_nav_user_favorites');
            var parsedFavs = rawFavs ? JSON.parse(rawFavs) : [];
            isPinned = parsedFavs.some(function(x) { return x.id === cardId; });
          } catch (e) {
            isPinned = false;
          }
        }
        var pinClass = isPinned ? 'nav-card-pin-btn is-pinned' : 'nav-card-pin-btn';
        var pinTitle = isPinned ? '从我的常用中移除' : '收藏至我的常用';
        var offlineBadge = (item.is_alive === false) ? '<span class="nav-card-offline-pill" title="该站点当前网络状态受限">⚠️ 状态受限</span>' : '';

        var feedUrl = item.feed_url || '';
        if (!feedUrl && item.repo) {
          feedUrl = 'https://github.com/' + item.repo + '/releases.atom';
        } else if (!feedUrl && (item.item_type === 'github' || item.category === 'github') && item.url) {
          var gm = item.url.match(/github\.com\/([^\/]+\/[^\/]+)/);
          if (gm) feedUrl = 'https://github.com/' + gm[1].replace(/\.git$/, '') + '/releases.atom';
        }
        if (!feedUrl && item.type === 'channel' && item.username) {
          feedUrl = 'https://rsshub.app/telegram/channel/' + item.username;
        }
        if (feedUrl) {
          a.setAttribute('data-feed-url', feedUrl);
        }

        var isGhFeed = feedUrl && (feedUrl.indexOf('releases.atom') !== -1 || feedUrl.indexOf('github.com') !== -1);
        var feedBtnTitle = isGhFeed ? '查看最新动态 (Release Atom)' : '查看最新动态 (RSS/Atom)';

        var feedBtnHtml = feedUrl ? (
          '<button type="button" class="nav-card-feed-btn" title="' + feedBtnTitle + '" data-feed-url="' + escapeHtml(feedUrl) + '" data-title="' + escapeHtml(item.title) + '">' +
            '<svg viewBox="0 0 24 24"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>' +
          '</button>'
        ) : '';

        var isRecent = false;
        if (item.created_at) {
          var createdMs = new Date(item.created_at).getTime();
          if (!isNaN(createdMs)) {
            var diffDays = (Date.now() - createdMs) / (1000 * 60 * 60 * 24);
            if (diffDays >= -0.5 && diffDays <= 2) isRecent = true;
          }
        }
        var newBadge = isRecent ? '<span class="nav-badge badge-new" title="新收录 (' + escapeHtml(item.created_at) + ')">NEW</span>' : '';

        a.innerHTML =
          '<div>' +
            '<div class="nav-card-header">' +
              '<div class="nav-card-avatar icon-small">' + iconHtml + '</div>' +
              '<div class="nav-card-info">' +
                '<div class="nav-card-title-row">' +
                  '<span class="nav-card-title" title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + '</span>' +
                  newBadge +
                  offlineBadge +
                  (isRecent ? '' : ('<span class="nav-badge ' + badgeClass + '">' + badgeLabel + '</span>')) +
                '</div>' +
              '</div>' +
            '</div>' +
            '<p class="nav-card-desc">' + escapeHtml(item.description || '') + '</p>' +
          '</div>' +
          '<div class="nav-card-footer">' +
            '<div class="nav-card-tags">' + tagsHtml + '</div>' +
            '<div class="nav-card-stat">' +
              '<span>' + escapeHtml(statHtml) + '</span>' +
              '<div class="nav-card-actions-group">' +
                feedBtnHtml +
                '<button type="button" class="' + pinClass + '" title="' + pinTitle + '" data-id="' + escapeHtml(cardId) + '">' +
                  '<svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>' +
                '</button>' +
                '<button type="button" class="nav-card-copy-btn" title="复制卡片直达链接" data-id="' + escapeHtml(cardId) + '">' +
                  '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>' +
                '</button>' +
              '</div>' +
            '</div>' +
          '</div>';

        attach3DTilt(a, 6);


        // Bind copy button
        var copyBtn = a.querySelector('.nav-card-copy-btn');
        if (copyBtn) {
          copyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var targetId = cardId;
            var shareUrl = window.location.origin + window.location.pathname + '#' + targetId;
            copyToClipboard(shareUrl, function() {
              copyBtn.classList.add('is-copied');
              showNavToast('✓ 直达链接已复制到剪贴板');
              try {
                history.replaceState(null, '', '#' + targetId);
              } catch (err) {}
              a.classList.add('card-anchor-highlight');
              setTimeout(function() {
                copyBtn.classList.remove('is-copied');
                a.classList.remove('card-anchor-highlight');
              }, 2500);
            });
          });
        }

        // Bind pin button
        var pinBtn = a.querySelector('.nav-card-pin-btn');
        if (pinBtn) {
          pinBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (e.__navPinHandled__) return;
            e.__navPinHandled__ = true;
            if (typeof window.executeNavCardPin === 'function') {
              window.executeNavCardPin(pinBtn);
              return;
            }
            if (typeof window.toggleNavFavorite === 'function') {
              var itemPayload = {
                id: cardId,
                title: item.title,
                url: item.url,
                description: item.description,
                icon: item.icon || item.avatar_url,
                tags: item.tags || [],
                item_type: item.item_type || 'website'
              };
              var isNowFav = window.toggleNavFavorite(itemPayload);
              if (isNowFav) {
                pinBtn.classList.add('is-pinned');
                pinBtn.title = '从我的常用中移除';
                showNavToast('⭐ 已收藏至我的常用看板');
              } else {
                pinBtn.classList.remove('is-pinned');
                pinBtn.title = '收藏至我的常用';
                showNavToast('✓ 已从我的常用中移除');
              }
            }
          });
        }

        return a;
      }

      function appendNextChunk() {
        var start = renderedCount;
        var end = Math.min(start + CHUNK_SIZE, filteredItems.length);
        if (start >= end) {
          loadMoreWrap.style.display = 'none';
          return;
        }

        var frag = document.createDocumentFragment();
        for (var i = start; i < end; i++) {
          frag.appendChild(renderCard(filteredItems[i], i));
        }
        grid.appendChild(frag);
        renderedCount = end;

        if (window.applyNavMirrorPreferences) {
          window.applyNavMirrorPreferences();
        }

        if (typeof window.applyNavCustomFeeds === 'function') {
          window.applyNavCustomFeeds();
        }
        if (typeof window.refreshNavFeedCardBadges === 'function') {
          window.refreshNavFeedCardBadges();
        }
        if (typeof window.scheduleNavFeedPrefetch === 'function') {
          window.scheduleNavFeedPrefetch();
        }

        var remaining = filteredItems.length - renderedCount;
        if (remaining > 0) {
          loadMoreWrap.style.display = 'flex';
          remainingCountEl.textContent = '(' + remaining + ')';
        } else {
          loadMoreWrap.style.display = 'none';
        }
      }



      function scrollToWorkspaceTop() {
        var target = document.querySelector('.vertical-main') || document.getElementById('cat-card-grid');
        if (!target) return;
        var headerOffset = 75; // 60px sticky header + 15px comfort gap
        var targetTop = target.getBoundingClientRect().top + window.pageYOffset;
        var desiredScrollY = Math.max(0, targetTop - headerOffset);
        window.scrollTo({
          top: desiredScrollY,
          behavior: 'smooth'
        });
      }

      function setSubcat(targetSub) {
        activeSubcat = targetSub || 'all';
        if (subcatGroup) {
          subcatGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(b) {
            b.classList.toggle('is-active', (b.getAttribute('data-sub') || 'all') === activeSubcat);
          });
        }
        applyFilters(true);
        scrollToWorkspaceTop();
      }

      function applyFilters(shouldSyncUrl) {
        var q = activeQuery.toLowerCase().trim();
        filteredItems = allItems.filter(function(item) {
          if (activeSubcat !== 'all' && item.subcategory !== activeSubcat) return false;
          if (activeType !== 'all') {
            if (item.pricing && item.pricing !== activeType) return false;
            if (item.platform && item.platform.toLowerCase() !== activeType.toLowerCase()) return false;
            if (item.type && item.type !== activeType) return false;
          }
          if (q) {
            var searchStr = (item.title + ' ' + (item.description || '') + ' ' + (item.tags || []).join(' ') + ' ' + item.url).toLowerCase();
            if (searchStr.indexOf(q) === -1) return false;
          }
          return true;
        });

        // Apply Sorting
        if (activeSort === 'title') {
          filteredItems.sort(function(a, b) {
            return (a.title || '').localeCompare(b.title || '');
          });
        } else if (activeSort === 'visits') {
          filteredItems.sort(function(a, b) {
            var countA = (typeof window.getNavVisitCount === 'function') ? window.getNavVisitCount(a.id) : 0;
            var countB = (typeof window.getNavVisitCount === 'function') ? window.getNavVisitCount(b.id) : 0;
            return countB - countA;
          });
        } else if (activeSort === 'default') {
          filteredItems.sort(function(a, b) {
            var featA = a.is_featured ? 1 : 0;
            var featB = b.is_featured ? 1 : 0;
            if (featA !== featB) return featB - featA;
            var timeA = a.created_at ? new Date(a.created_at).getTime() : 0;
            var timeB = b.created_at ? new Date(b.created_at).getTime() : 0;
            if (timeA !== timeB) return timeB - timeA;
            return 0;
          });
        }

        filteredCountEl.textContent = filteredItems.length;
        if (filteredItems.length === 0) {
          grid.innerHTML = '';
          emptyState.style.display = 'flex';
          loadMoreWrap.style.display = 'none';

          if (fuzzyWrap && fuzzyList) {
            if (activeQuery) {
              var suggestions = computeFuzzySuggestions(activeQuery, allItems, 3);
              if (suggestions.length > 0) {
                fuzzyList.innerHTML = '';
                suggestions.forEach(function(title) {
                  var chip = document.createElement('button');
                  chip.type = 'button';
                  chip.className = 'nav-empty-fuzzy-chip';
                  chip.textContent = title;
                  chip.addEventListener('click', function() {
                    activeQuery = title;
                    if (searchInput) searchInput.value = title;
                    applyFilters(true);
                  });
                  fuzzyList.appendChild(chip);
                });
                fuzzyWrap.style.display = 'flex';
              } else {
                fuzzyWrap.style.display = 'none';
              }
            } else {
              fuzzyWrap.style.display = 'none';
            }
          }
        } else {
          emptyState.style.display = 'none';
          if (fuzzyWrap) fuzzyWrap.style.display = 'none';

          grid.innerHTML = '';
          renderedCount = 0;
          appendNextChunk();
        }

        var isFiltered = activeSubcat !== 'all' || activeType !== 'all' || !!activeQuery || activeSort !== 'default';
        resetBtn.style.display = isFiltered ? 'inline-block' : 'none';

        if (activeQuery) {
          queryTag.style.display = 'inline-flex';
          queryText.textContent = activeQuery;
        } else {
          queryTag.style.display = 'none';
        }

        if (shouldSyncUrl !== false) {
          syncUrlState();
        }
      }

      function syncUrlState() {
        if (!window.history || !window.history.replaceState) return;
        var params = new URLSearchParams();
        if (activeSubcat !== 'all') params.set('sub', activeSubcat);
        if (activeType !== 'all') params.set('type', activeType);
        if (activeSort !== 'default') params.set('sort', activeSort);
        if (activeQuery) params.set('q', activeQuery);

        var qs = params.toString();
        var newUrl = window.location.pathname + (qs ? '?' + qs : '');
        if (newUrl !== window.location.pathname + window.location.search) {
          window.history.replaceState(null, '', newUrl);
        }
      }

      function restoreStateFromUrl() {
        var params = new URLSearchParams(window.location.search);
        activeSubcat = params.get('sub') || 'all';
        activeType = params.get('type') || 'all';
        activeSort = params.get('sort') || 'default';
        activeQuery = params.get('q') || '';

        if (searchInput) searchInput.value = activeQuery;
        if (sortSelect) sortSelect.value = activeSort;

        if (subcatGroup) {
          subcatGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(btn) {
            btn.classList.toggle('is-active', (btn.getAttribute('data-sub') || 'all') === activeSubcat);
          });
        }

        if (typeGroup) {
          typeGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(btn) {
            btn.classList.toggle('is-active', (btn.getAttribute('data-type') || 'all') === activeType);
          });
        }

        applyFilters(false);
      }

      // Bind Subcategory Filter Pills
      var subcatGroup = document.getElementById('cat-subcat-filter-group');
      if (subcatGroup) {
        subcatGroup.addEventListener('click', function(e) {
          var btn = e.target.closest('.vertical-sidebar-item, .cat-pill');
          if (!btn) return;
          var targetSub = btn.getAttribute('data-sub') || 'all';
          setSubcat(targetSub);
        });
      }



      // Bind Type Filter Pills
      var typeGroup = document.getElementById('cat-type-filter-group');
      if (typeGroup) {
        typeGroup.addEventListener('click', function(e) {
          var btn = e.target.closest('.vertical-sidebar-item, .cat-pill');
          if (!btn) return;
          typeGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          activeType = btn.getAttribute('data-type') || 'all';
          applyFilters(true);
          scrollToWorkspaceTop();
        });
      }

      // Bind Sort Select
      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          activeSort = sortSelect.value;
          applyFilters(true);
        });
      }

      // Bind Search Input with debouncing
      if (searchInput) {
        var debounceTimer = null;
        searchInput.addEventListener('input', function() {
          activeQuery = searchInput.value;
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            applyFilters(true);
          }, 150);
        });
      }

      var cmdKTrigger = document.getElementById('header-cmd-k-trigger');
      if (cmdKTrigger) {
        cmdKTrigger.addEventListener('click', function(e) {
          if (e.target === searchInput) return;
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      var keyShortcut = document.querySelector('.nav-key-shortcut');
      if (keyShortcut) {
        keyShortcut.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.openNavCommandPalette) {
            window.openNavCommandPalette();
          }
        });
      }

      if (clearQueryBtn) {
        clearQueryBtn.addEventListener('click', function() {
          activeQuery = '';
          if (searchInput) searchInput.value = '';
          applyFilters(true);
        });
      }

      function resetAll() {
        activeSubcat = 'all';
        activeType = 'all';
        activeQuery = '';
        activeSort = 'default';
        if (searchInput) searchInput.value = '';
        if (sortSelect) sortSelect.value = 'default';

        if (subcatGroup) {
          subcatGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(b) {
            b.classList.toggle('is-active', (b.getAttribute('data-sub') || 'all') === 'all');
          });
        }
        if (typeGroup) {
          typeGroup.querySelectorAll('.vertical-sidebar-item, .cat-pill').forEach(function(b) {
            b.classList.toggle('is-active', (b.getAttribute('data-type') || 'all') === 'all');
          });
        }
        applyFilters(true);
        scrollToWorkspaceTop();
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
      if (loadMoreBtn) loadMoreBtn.addEventListener('click', appendNextChunk);

      if (typeof IntersectionObserver !== 'undefined' && loadMoreWrap) {
        var infiniteSentinelObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting && renderedCount < filteredItems.length) {
              appendNextChunk();
            }
          });
        }, { rootMargin: '250px' });
        infiniteSentinelObserver.observe(loadMoreWrap);
      }

      // Spotlight Engine (Parity with Telegram & GitHub)
      var btnShuffleSpotlight = document.getElementById('btn-shuffle-spotlight');
      var heroSpotlightCard = document.getElementById('hero-spotlight-card');
      var lastSpotlightIndex = -1;

      function pickSpotlightItem() {
        if (!allItems.length) return;
        var candidates = allItems.filter(function(t) { return t.is_featured; });
        var pool = candidates.length > 0 ? candidates : allItems;
        var idx;
        if (pool.length > 1) {
          do {
            idx = Math.floor(Math.random() * pool.length);
          } while (idx === lastSpotlightIndex);
        } else {
          idx = 0;
        }
        lastSpotlightIndex = idx;
        renderSpotlight(pool[idx]);
      }

      function renderSpotlight(item) {
        var el = document.getElementById('spotlight-dynamic-content');
        if (!el || !item) return;

        var subName = item.subcategory || '实用工具';
        var domain = (item.url || '').replace(/^https?:\/\//, '').replace(/\/.*$/, '');
        var pricingText = item.pricing ? (item.pricing === 'free' ? '免费' : (item.pricing === 'freemium' ? '免费试用' : item.pricing)) : '';
        var metaSubText = domain + (pricingText ? ' · ' + pricingText : '');

        var avatarHtml = '';
        if (item.icon) {
          avatarHtml = '<img class="spotlight-avatar" src="' + escapeHtml(item.icon) + '" alt="' + escapeHtml(item.title) + '" loading="eager" decoding="async" fetchpriority="high" onerror="this.style.display=\'none\'; if (this.nextElementSibling) this.nextElementSibling.style.display=\'flex\';" />';
        } else {
          avatarHtml = '<div class="spotlight-avatar-fallback"><span style="font-size: 24px;">🛠️</span></div>';
        }

        el.style.opacity = '0';
        setTimeout(function() {
          el.innerHTML =
            '<div class="spotlight-avatar-wrap" onclick="window.open(\'' + escapeHtml(item.url) + '\', \'_blank\');">' +
              avatarHtml +
            '</div>' +
            '<div class="spotlight-meta">' +
              '<div class="spotlight-name-row">' +
                '<span class="spotlight-name" title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + '</span>' +
                '<span class="spotlight-type-badge">' + escapeHtml(subName) + '</span>' +
              '</div>' +
              '<a class="spotlight-handle" href="' + escapeHtml(item.url) + '" target="_blank">' + escapeHtml(metaSubText) + '</a>' +
              '<div class="spotlight-bio-snippet">' + escapeHtml(item.description || item.title) + '</div>' +
            '</div>';
          el.style.opacity = '1';
        }, 120);
      }

      if (btnShuffleSpotlight) {
        btnShuffleSpotlight.addEventListener('click', function(e) {
          pickSpotlightItem();
        });
      }

      if (heroSpotlightCard) {
        attach3DTilt(heroSpotlightCard, 5);
        heroSpotlightCard.addEventListener('mousemove', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
        heroSpotlightCard.addEventListener('mouseenter', function(e) {
          updateCardGlow(heroSpotlightCard, e);
        });
      }

      pickSpotlightItem();

      // Deep-link Hash Anchor traversal
      function appendUntilTarget(targetId) {
        while (!document.getElementById(targetId) && renderedCount < filteredItems.length) {
          appendNextChunk();
        }
      }

      function handleHashDeepLink() {
        var hash = window.location.hash ? window.location.hash.substring(1) : '';
        if (!hash) return;
        appendUntilTarget(hash);
        var el = document.getElementById(hash);
        if (el) {
          setTimeout(function() {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.add('card-anchor-highlight');
            setTimeout(function() { el.classList.remove('card-anchor-highlight'); }, 3000);
          }, 150);
        }
      }

      window.addEventListener('hashchange', handleHashDeepLink);

      function syncCategoryPinButtons() {
        var pinButtons = document.querySelectorAll('.nav-card-pin-btn');
        pinButtons.forEach(function(btn) {
          var id = btn.getAttribute('data-id');
          if (!id) return;
          var isFav = false;
          if (typeof window.isNavFavorite === 'function') {
            isFav = window.isNavFavorite(id);
          } else {
            try {
              var rawFavs = localStorage.getItem('xiu_nav_user_favorites');
              var parsedFavs = rawFavs ? JSON.parse(rawFavs) : [];
              isFav = parsedFavs.some(function(x) { return x.id === id; });
            } catch (e) {
              isFav = false;
            }
          }
          btn.classList.toggle('is-pinned', isFav);
          btn.title = isFav ? '从我的常用中移除' : '收藏至我的常用';
        });
      }

      window.addEventListener('nav-favorites-updated', syncCategoryPinButtons);
      window.addEventListener('nav-favorites-ready', syncCategoryPinButtons);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncCategoryPinButtons);
      } else {
        syncCategoryPinButtons();
      }

      // Initial Render with URL query restoration & popstate history support
      window.addEventListener('popstate', restoreStateFromUrl);
      restoreStateFromUrl();
      handleHashDeepLink();
    })();
  </script>
</NavLayout>

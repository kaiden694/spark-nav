          var spark = document.createElement('div');
          spark.className = 'click-spark-particle';
          spark.style.left = x + 'px';
          spark.style.top = y + 'px';
          spark.style.background = targetColor;

          var angle = (Math.PI * 2 * i) / (sparkCount || 8) + (Math.random() - 0.5);

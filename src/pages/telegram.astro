      function computeFuzzySuggestions(query, items, maxResults) {
        if (!query || !items || !items.length) return [];
        var q = query.toLowerCase().trim();
        if (!q) return [];
        var max = maxResults || 3;
        var candidates = [];
        var seen = {};

        for (var i = 0; i < items.length; i++) {
          var title = (items[i].title || '').trim();
          if (!title || seen[title.toLowerCase()]) continue;
          seen[title.toLowerCase()] = true;
          
          var tLower = title.toLowerCase();
          var score = 0;
          if (tLower === q) continue;

          if (tLower.indexOf(q) === 0) {
            score = 100 - (tLower.length - q.length);
          } else if (tLower.indexOf(q) !== -1) {
            score = 70 - tLower.indexOf(q);
          } else {
            var matches = 0;
            var qChars = q.split('');
            var lastIdx = -1;
            for (var c = 0; c < qChars.length; c++) {
              var idx = tLower.indexOf(qChars[c], lastIdx + 1);
              if (idx > lastIdx) {
                matches++;
                lastIdx = idx;
              }
            }
            var ratio = matches / q.length;
            if (ratio >= 0.5) {
              score = Math.round(ratio * 50);
            }
          }

          if (score > 10) {
            candidates.push({ title: title, score: score });
          }
        }

        candidates.sort(function(a, b) { return b.score - a.score; });
        return candidates.slice(0, max).map(function(c) { return c.title; });
      }


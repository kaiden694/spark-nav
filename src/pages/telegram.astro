        var pool = candidates.length > 0 ? candidates : allItems;
        var idx;
        if (pool.length > 1) {
          do {
            idx = Math.floor(Math.random() * pool.length);
          } while (idx === lastSpotlightIndex);
        } else {
          idx = 0;
        }
        lastSpotlightIndex = idx;
        renderSpotlight(pool[idx]);
      }


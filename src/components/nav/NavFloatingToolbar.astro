  }

  [data-theme="light"] .nav-modal-dialog {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }

  [data-theme="light"] .nav-modal-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  [data-theme="light"] .nav-modal-title {
    color: #0f172a;
  }

  [data-theme="light"] .nav-modal-subtitle {
    color: #64748b;
  }

  [data-theme="light"] .nav-modal-close {
    color: #64748b;
  }

  [data-theme="light"] .nav-modal-close:hover {
    color: #0f172a;
  }

  [data-theme="light"] .nav-form-label {
    color: #334155;
  }

  [data-theme="light"] .nav-form-input,
  [data-theme="light"] .nav-form-select,
  [data-theme="light"] .nav-form-textarea {
    background: #f8fafc;
    border-color: rgba(0, 0, 0, 0.12);
    color: #0f172a;
  }

  [data-theme="light"] .nav-modal-footer {
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  [data-theme="light"] .nav-btn-copy {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.12);
    color: #1e293b;
  }

  [data-theme="light"] .nav-btn-copy:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #0f172a;
  }

  /* ============================================================
     Mobile Responsive (<768px)
     ============================================================ */
  @media (max-width: 768px) {
    .nav-float-bar {
      right: 14px;
      bottom: 24px;
      gap: 8px;
    }

    .nav-float-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
    }

    .nav-float-icon {
      width: 18px;
      height: 18px;
    }

    .nav-float-tooltip {
      display: none !important;
    }

    .nav-float-desktop-only {
      display: none !important;
    }

    .nav-float-bot-card {
      right: 0;
      bottom: calc(100% + 10px);
      width: calc(100vw - 32px);
      max-width: 320px;
    }

    .nav-modal-dialog {
      max-height: 90vh;
      border-radius: 16px;
    }
  }
</style>

<script is:inline>
  (function() {
    // 1. Back to Top Scroll Tracker
    var totopWrap = document.getElementById('nav-float-totop-wrap');
    var totopBtn = document.getElementById('nav-float-totop-btn');

    function checkScrollTop() {
      if (!totopWrap) return;
      var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      if (scrollY > 300) {
        totopWrap.classList.add('is-visible');
      } else {
        totopWrap.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', checkScrollTop, { passive: true });
    checkScrollTop();

    if (totopBtn) {
      totopBtn.addEventListener('click', function(e) {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }

    // 2. Quick Search Button Linkage
    var searchBtn = document.getElementById('nav-float-search-btn');
    if (searchBtn) {
      searchBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openNavCommandPalette === 'function') {
          window.openNavCommandPalette();
        }
      });
    }

    // 2b. Keyboard Shortcuts HUD Linkage
    var shortcutsBtn = document.getElementById('nav-float-shortcuts-btn');
    if (shortcutsBtn) {
      shortcutsBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openNavShortcutsModal === 'function') {
          window.openNavShortcutsModal();
        }
      });
    }

    // 2c. Cloud Sync Modal Linkage
    var syncBtn = document.getElementById('nav-float-sync-btn');
    if (syncBtn) {
      syncBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openNavCloudSyncModal === 'function') {
          window.openNavCloudSyncModal();
        }
      });
    }

    // 3. Telegram Bot Handle Copy
    var botCopyBtn = document.getElementById('nav-bot-copy-handle-btn');
    if (botCopyBtn) {
      botCopyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        copyText('@xiunav_bot', '已复制 Bot 用户名 @xiunav_bot');
      });
    }

    // Toggle Bot Card on Touch / Click
    var botBtn = document.getElementById('nav-float-bot-btn');
    var botItem = document.querySelector('.nav-float-bot-item');
    if (botBtn && botItem) {
      botBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        botItem.classList.toggle('is-open');
      });

      document.addEventListener('click', function(e) {
        if (!botItem.contains(e.target)) {
          botItem.classList.remove('is-open');
        }
      });
    }

    // 4. Submit Modal Handler
    var submitModal = document.getElementById('nav-submit-modal');
    var submitBtn = document.getElementById('nav-float-submit-btn');
    var submitClose = document.getElementById('nav-submit-close');

    function openSubmitModal() {
      if (!submitModal) return;
      submitModal.style.display = 'flex';
      setTimeout(function() {
        submitModal.classList.add('is-open');
        var input = document.getElementById('sub-site-title');
        if (input) input.focus();
      }, 10);
    }

    function closeSubmitModal() {
      if (!submitModal) return;
      submitModal.classList.remove('is-open');
      setTimeout(function() {
        submitModal.style.display = 'none';
      }, 200);
    }

    if (submitBtn) submitBtn.addEventListener('click', openSubmitModal);
    if (submitClose) submitClose.addEventListener('click', closeSubmitModal);
    if (submitModal) {
      submitModal.addEventListener('click', function(e) {
        if (e.target === submitModal) closeSubmitModal();
      });
    }

    // Build Submission Text
    function getSubmissionText() {
      var title = (document.getElementById('sub-site-title').value || '').trim();
      var url = (document.getElementById('sub-site-url').value || '').trim();
      var cat = document.getElementById('sub-site-cat').value || 'featured';
      var contact = (document.getElementById('sub-site-contact').value || '').trim();
      var desc = (document.getElementById('sub-site-desc').value || '').trim();

      var catMap = {
        'featured': '常用精选',
        'tools': '实用工具',
        'github': '开源矩阵',
        'telegram': '电报生态',
        'creators': '优质博主'
      };
      var catLabel = catMap[cat] || cat;

      return {
        title: title,
        url: url,
        cat: cat,
        catLabel: catLabel,
        contact: contact,
        desc: desc,
        formatted: '【站点收录申请】\n' +
          '• 站点名称：' + (title || '未填写') + '\n' +
          '• 访问地址：' + (url || '未填写') + '\n' +
          '• 建议分类：' + catLabel + '\n' +
          '• 推荐理由：' + (desc || '无') + '\n' +
          '• 申请联系：' + (contact || '匿名')
      };
    }

    // Submit Actions
    var subToBotBtn = document.getElementById('nav-submit-to-bot-btn');
    if (subToBotBtn) {
      subToBotBtn.addEventListener('click', function() {
        var data = getSubmissionText();
        if (!data.title || !data.url) {
          showToast('请至少填写站点名称与链接');
          return;
        }
        var msg = encodeURIComponent('/submit ' + data.formatted);
        var targetUrl = 'https://t.me/xiunav_bot?text=' + msg;
        window.open(targetUrl, '_blank', 'noopener,noreferrer');
        closeSubmitModal();
      });
    }

    var subCopyBtn = document.getElementById('nav-submit-copy-btn');
    if (subCopyBtn) {
      subCopyBtn.addEventListener('click', function() {
        var data = getSubmissionText();
        if (!data.title || !data.url) {
          showToast('请至少填写站点名称与链接');
          return;
        }
        copyText(data.formatted, '已复制收录申请文案，可直接发送给站长');
      });
    }

    var subIssueBtn = document.getElementById('nav-submit-issue-btn');
    if (subIssueBtn) {
      subIssueBtn.addEventListener('click', function() {
        var data = getSubmissionText();
        var issueTitle = encodeURIComponent('[站点收录申请] ' + (data.title || '新资源推荐'));
        var issueBody = encodeURIComponent('### 资源信息\n\n' + data.formatted + '\n\n---\n*通过神站导航在线收录助手提交*');
        var githubRepo = 'your-repo/your-nav'; // Default fallback or project repo
        window.open('https://github.com/' + githubRepo + '/issues/new?title=' + issueTitle + '&body=' + issueBody, '_blank');
      });
    }

    // 5. Broken Link Report Modal Handler
    var reportModal = document.getElementById('nav-report-modal');
    var reportBtn = document.getElementById('nav-float-report-btn');
    var reportClose = document.getElementById('nav-report-close');

    function openReportModal(defaultTarget, defaultIssueType) {
      if (!reportModal) return;
      var targetInput = document.getElementById('rep-site-target');
      var typeSelect = document.getElementById('rep-issue-type');
      var detailsTextarea = document.getElementById('rep-issue-details');

      if (typeof defaultTarget === 'object' && defaultTarget !== null) {
        if (targetInput && defaultTarget.target) targetInput.value = defaultTarget.target;
        if (typeSelect && defaultTarget.issueType) typeSelect.value = defaultTarget.issueType;
        if (detailsTextarea && defaultTarget.details) detailsTextarea.value = defaultTarget.details;
      } else if (typeof defaultTarget === 'string' && targetInput) {
        targetInput.value = defaultTarget;
        if (typeSelect && defaultIssueType) typeSelect.value = defaultIssueType;
      }

      reportModal.style.display = 'flex';
      setTimeout(function() {
        reportModal.classList.add('is-open');
        if (targetInput && !targetInput.value) {
          targetInput.focus();
        } else if (detailsTextarea) {
          detailsTextarea.focus();
        }
      }, 10);
    }

    function closeReportModal() {
      if (!reportModal) return;
      reportModal.classList.remove('is-open');
      setTimeout(function() {
        reportModal.style.display = 'none';
      }, 200);
    }

    if (reportBtn) reportBtn.addEventListener('click', function() { openReportModal(); });
    if (reportClose) reportClose.addEventListener('click', closeReportModal);
    if (reportModal) {
      reportModal.addEventListener('click', function(e) {
        if (e.target === reportModal) closeReportModal();
      });
    }

    function getReportText() {
      var target = (document.getElementById('rep-site-target').value || '').trim();
      var type = document.getElementById('rep-issue-type').value || 'broken';
      var details = (document.getElementById('rep-issue-details').value || '').trim();

      var typeMap = {
        'broken': '无法访问 / 死链',
        'changed': '域名变更',
        'scam': '涉及欺诈 / 违规',
        'cat_err': '分类划分有误',
        'info_err': '信息错误'
      };
      var typeLabel = typeMap[type] || type;

      return {
        target: target,
        typeLabel: typeLabel,
        details: details,
        formatted: '【站点失效/纠错反馈】\n' +
          '• 目标站点：' + (target || '未填写') + '\n' +
          '• 异常类型：' + typeLabel + '\n' +
          '• 详细说明：' + (details || '无')
      };
    }

    var repToBotBtn = document.getElementById('nav-report-to-bot-btn');
    if (repToBotBtn) {
      repToBotBtn.addEventListener('click', function() {
        var data = getReportText();
        if (!data.target) {
          showToast('请填写失效站点的名称或网址');
          return;
        }
        var msg = encodeURIComponent('/report ' + data.formatted);
        var targetUrl = 'https://t.me/xiunav_bot?text=' + msg;
        window.open(targetUrl, '_blank', 'noopener,noreferrer');
        closeReportModal();
      });
    }

    var repCopyBtn = document.getElementById('nav-report-copy-btn');
    if (repCopyBtn) {
      repCopyBtn.addEventListener('click', function() {
        var data = getReportText();
        if (!data.target) {
          showToast('请填写失效站点的名称或网址');
          return;
        }
        copyText(data.formatted, '已复制纠错文案，可直接发送给站长');
      });
    }

    // Global Esc Handler for Modals
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (submitModal && submitModal.classList.contains('is-open')) {
          closeSubmitModal();
        } else if (reportModal && reportModal.classList.contains('is-open')) {
          closeReportModal();
        }
      }
    });

    // Clipboard Copy Helper
    function copyText(text, successMsg) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function() {
          showToast(successMsg);
        }).catch(function() {
          fallbackCopy(text, successMsg);
        });
      } else {
        fallbackCopy(text, successMsg);
      }
    }

    function fallbackCopy(text, successMsg) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        showToast(successMsg);
      } catch (err) {
        showToast('复制失败，请手动选择复制');
      }
      document.body.removeChild(ta);
    }

    function showToast(msg) {
      if (typeof window.showNavToast === 'function') {
        window.showNavToast(msg);
      } else {
        var c = document.getElementById('nav-toast-container');
        if (!c) {
          c = document.createElement('div');
          c.id = 'nav-toast-container';
          c.className = 'nav-toast-container';
          document.body.appendChild(c);
        }
        var t = document.createElement('div');
        t.className = 'nav-toast-item';
        t.textContent = msg;
        c.appendChild(t);
        setTimeout(function() {
          t.style.transition = 'opacity 0.2s, transform 0.2s';
          t.style.opacity = '0';
          t.style.transform = 'translateY(10px)';
          setTimeout(function() { t.remove(); }, 200);
        }, 2200);
      }
    }

    // Expose global methods for other buttons to trigger submit/report with context
    window.openNavSubmitModal = openSubmitModal;
    window.openNavReportModal = openReportModal;
  })();
</script>

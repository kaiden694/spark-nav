---
// CardQuickPreviewPopover.astro
// Floating Instant Rich Quick Preview Popover Engine for XIU Navigation Ecosystem
// Provides zero-latency, debounce-controlled panoramic metadata inspection (VisionOS glass style)
---

<div
  id="nav-quick-preview-popover"
  class="nav-quick-preview-popover"
  style="display: none;"
  role="tooltip"
  aria-hidden="true"
>
  <div class="quick-preview-arrow" id="quick-preview-arrow"></div>

  <!-- Header -->
  <div class="quick-preview-header">
    <div class="quick-preview-avatar-box" id="qp-avatar-box">
      <!-- Injected dynamically -->
    </div>
    <div class="quick-preview-titles">
      <div class="quick-preview-title-row">
        <h4 id="qp-title" class="quick-preview-title">资源标题</h4>
        <span id="qp-badge" class="quick-preview-badge">精选</span>
      </div>
      <div class="quick-preview-meta-row">
        <span id="qp-domain" class="quick-preview-domain">example.com</span>
        <span class="quick-preview-dot">&bull;</span>
        <span id="qp-status-indicator" class="quick-preview-status online">● 在线畅通</span>
      </div>
    </div>
  </div>

  <!-- Body Content -->
  <div class="quick-preview-body">
    <!-- Full Description -->
    <p id="qp-desc" class="quick-preview-desc">资源详细描述与核心功能说明...</p>

    <!-- Dynamic Metrics Grid -->
    <div id="qp-metrics" class="quick-preview-metrics">
      <!-- Injected dynamically: Stars, Forks, Language, License, Members, Pricing, Platforms -->
    </div>

    <!-- Tags Cloud -->
    <div class="quick-preview-tags-section">
      <span class="quick-preview-section-title">意图与特性标签</span>
      <div id="qp-tags" class="quick-preview-tags">
        <!-- Injected dynamically -->
      </div>
    </div>

    <!-- Mirrors Strip (Conditionally rendered) -->
    <div id="qp-mirrors-section" class="quick-preview-mirrors-section" style="display: none;">
      <span class="quick-preview-section-title">⚡ 极速镜像直达</span>
      <div id="qp-mirrors-list" class="quick-preview-mirrors-list">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="quick-preview-footer">
    <div class="quick-preview-footer-left">
      <button type="button" id="qp-pin-btn" class="quick-preview-action-btn" title="收藏至我的常用">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
        <span id="qp-pin-text">加入常用</span>
      </button>
      <button type="button" id="qp-copy-btn" class="quick-preview-action-btn" title="复制卡片直达链接">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span>复制直达</span>
      </button>
    </div>
    <a id="qp-open-link" href="#" target="_blank" rel="noopener noreferrer" class="quick-preview-direct-btn">
      <span>访问主站</span>
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>
</div>

<style is:global>
  .nav-quick-preview-popover {
    position: fixed;
    z-index: 9998;
    width: 360px;
    max-width: calc(100vw - 28px);
    background: rgba(18, 22, 34, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96) translateY(4px);
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .nav-quick-preview-popover.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) translateY(0);
  }

  :global([data-theme="light"]) .nav-quick-preview-popover {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  /* Header */
  .quick-preview-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  :global([data-theme="light"]) .quick-preview-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.01);
  }

  .quick-preview-avatar-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    overflow: hidden;
  }

  :global([data-theme="light"]) .quick-preview-avatar-box {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .quick-preview-avatar-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quick-preview-avatar-box svg {
    width: 22px;
    height: 22px;
    color: var(--nav-text-main, #ffffff);
  }

  :global([data-theme="light"]) .quick-preview-avatar-box svg {
    color: #1e293b;
  }

  .quick-preview-titles {
    flex: 1;
    min-width: 0;
  }

  .quick-preview-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .quick-preview-title {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--nav-text-main, #ffffff);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global([data-theme="light"]) .quick-preview-title {
    color: #0f172a;
  }

  .quick-preview-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
    flex-shrink: 0;
  }

  .quick-preview-badge.badge-github {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border-color: rgba(168, 85, 247, 0.3);
  }

  .quick-preview-badge.badge-telegram {
    background: rgba(14, 165, 233, 0.15);
    color: #38bdf8;
    border-color: rgba(14, 165, 233, 0.3);
  }

  .quick-preview-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 3px;
    font-size: 12px;
  }

  .quick-preview-domain {
    color: var(--nav-text-muted, #94a3b8);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quick-preview-dot {
    color: rgba(255, 255, 255, 0.2);
  }

  .quick-preview-status {
    font-size: 11px;
    font-weight: 500;
  }

  .quick-preview-status.online {
    color: #10b981;
  }

  .quick-preview-status.restricted {
    color: #f59e0b;
  }

  /* Body */
  .quick-preview-body {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    max-height: 380px;
  }

  .quick-preview-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--nav-text-sub, #cbd5e1);
  }

  :global([data-theme="light"]) .quick-preview-desc {
    color: #475569;
  }

  /* Metrics Grid */
  .quick-preview-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 10px;
  }

  :global([data-theme="light"]) .quick-preview-metrics {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.06);
  }

  .qp-metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qp-metric-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--nav-text-muted, #94a3b8);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .qp-metric-value {
    font-size: 12px;
    font-weight: 700;
    color: var(--nav-text-main, #ffffff);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global([data-theme="light"]) .qp-metric-value {
    color: #0f172a;
  }

  /* Section Title */
  .quick-preview-section-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--nav-text-muted, #94a3b8);
    margin-bottom: 6px;
    display: block;
  }

  /* Tags */
  .quick-preview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .qp-tag-pill {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--nav-text-sub, #94a3b8);
  }

  :global([data-theme="light"]) .qp-tag-pill {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
    color: #475569;
  }

  /* Mirrors */
  .quick-preview-mirrors-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .qp-mirror-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .qp-mirror-btn:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.45);
    transform: translateY(-1px);
  }

  /* Footer */
  .quick-preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  :global([data-theme="light"]) .quick-preview-footer {
    border-top-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.01);
  }

  .quick-preview-footer-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .quick-preview-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: var(--nav-text-sub, #cbd5e1);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global([data-theme="light"]) .quick-preview-action-btn {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
    color: #334155;
  }

  .quick-preview-action-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  :global([data-theme="light"]) .quick-preview-action-btn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #0f172a;
  }

  .quick-preview-action-btn.is-pinned {
    color: #eab308;
    border-color: rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.1);
  }

  .quick-preview-direct-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 8px;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    transition: all 0.15s ease;
  }

  .quick-preview-direct-btn:hover {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.5);
    transform: translateY(-1px);
  }
</style>

<script is:inline>
  (function() {
    var popover = document.getElementById('nav-quick-preview-popover');
    if (!popover) return;

    var avatarBox = document.getElementById('qp-avatar-box');
    var titleEl = document.getElementById('qp-title');
    var badgeEl = document.getElementById('qp-badge');
    var domainEl = document.getElementById('qp-domain');
    var statusEl = document.getElementById('qp-status-indicator');
    var descEl = document.getElementById('qp-desc');
    var metricsEl = document.getElementById('qp-metrics');
    var tagsEl = document.getElementById('qp-tags');
    var mirrorsSection = document.getElementById('qp-mirrors-section');
    var mirrorsList = document.getElementById('qp-mirrors-list');
    var pinBtn = document.getElementById('qp-pin-btn');
    var pinText = document.getElementById('qp-pin-text');
    var copyBtn = document.getElementById('qp-copy-btn');
    var openLink = document.getElementById('qp-open-link');

    var currentCard = null;
    var currentData = null;
    var hoverTimer = null;
    var closeTimer = null;
    var DEBOUNCE_MS = 420;
    var CLOSE_DELAY_MS = 220;

    // Helper: Escape HTML
    function esc(s) {
      if (!s) return '';
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Helper: Format large numbers (144K, 1.2M)
    function formatCount(num) {
      if (!num || isNaN(num)) return '-';
      num = Number(num);
      if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
      return String(num);
    }

    // Helper: Extract clean domain or repo slug
    function extractDisplayDomain(url, repo) {
      if (repo) return 'github.com/' + repo;
      if (!url) return '';
      try {
        var u = new URL(url);
        return u.hostname + (u.pathname !== '/' && u.pathname.length < 24 ? u.pathname : '');
      } catch (e) {
        return url;
      }
    }

    // Resolve comprehensive data from memory cache, scripts or DOM
    function resolveCardData(cardEl) {
      var id = cardEl.getAttribute('data-id') || cardEl.id;
      var data = null;

      // 1. Check in-memory global dataset
      if (window.__XIU_NAV_DATA__ && Array.isArray(window.__XIU_NAV_DATA__)) {
        data = window.__XIU_NAV_DATA__.find(function(it) { return it.id === id; });
      }

      // 2. Check local script #cat-raw-data if present
      if (!data) {
        var scriptTag = document.getElementById('cat-raw-data');
        if (scriptTag && !window.__CAT_DATA_PARSED__) {
          try {
            window.__CAT_DATA_PARSED__ = JSON.parse(scriptTag.textContent);
          } catch (e) {
            window.__CAT_DATA_PARSED__ = [];
          }
        }
        if (window.__CAT_DATA_PARSED__ && Array.isArray(window.__CAT_DATA_PARSED__)) {
          data = window.__CAT_DATA_PARSED__.find(function(it) { return it.id === id; });
        }
      }

      // 3. Fallback: Parse from DOM element attributes and inner nodes
      if (!data) {
        var title = cardEl.getAttribute('data-title') || (cardEl.querySelector('.nav-card-title') ? cardEl.querySelector('.nav-card-title').textContent.trim() : '');
        var url = cardEl.getAttribute('data-url') || cardEl.href || '';
        var repo = cardEl.getAttribute('data-repo') || '';
        var itemType = cardEl.getAttribute('data-type') || (repo ? 'github' : 'website');
        var isAlive = cardEl.getAttribute('data-is-alive') !== 'false';
        var mirrorsRaw = cardEl.getAttribute('data-mirrors');
        var mirrorUrls = mirrorsRaw ? mirrorsRaw.split(',').filter(Boolean) : [];
        var descNode = cardEl.querySelector('.nav-card-desc');
        var desc = descNode ? descNode.textContent.trim() : '';

        var tagNodes = cardEl.querySelectorAll('.nav-tag-pill');
        var tags = [];
        tagNodes.forEach(function(node) { tags.push(node.textContent.trim()); });

        data = {
          id: id,
          title: title,
          url: url,
          repo: repo,
          item_type: itemType,
          is_alive: isAlive,
          mirror_urls: mirrorUrls,
          description: desc,
          tags: tags
        };
      }

      return data;
    }

    // Populate and open Popover
    function openPopover(cardEl, focusInside) {
      currentCard = cardEl;
      var data = resolveCardData(cardEl);
      currentData = data;
      if (!data) return;

      // 1. Title & Badge
      titleEl.textContent = data.title || '资源详情';
      var badgeText = '精选';
      var badgeClass = 'badge-featured';
      if (data.item_type === 'github' || data.repo) {
        badgeText = '💻 开源';
        badgeClass = 'badge-github';
      } else if (data.item_type === 'telegram' || (data.url && data.url.includes('t.me/'))) {
        badgeText = '✈️ 电报';
        badgeClass = 'badge-telegram';
      } else if (data.item_type === 'creator') {
        badgeText = '👤 博主';
        badgeClass = 'badge-creator';
      } else if (data.item_type === 'website') {
        badgeText = '🛠️ 工具';
      }
      badgeEl.textContent = badgeText;
      badgeEl.className = 'quick-preview-badge ' + badgeClass;

      // 2. Domain & Status
      domainEl.textContent = extractDisplayDomain(data.url, data.repo);
      var isOffline = data.is_alive === false || cardEl.classList.contains('is-offline');
      if (isOffline) {
        statusEl.className = 'quick-preview-status restricted';
        statusEl.textContent = '⚠️ 状态受限';
      } else {
        statusEl.className = 'quick-preview-status online';
        statusEl.textContent = '● 在线畅通';
      }

      // 3. Avatar Clone or Icon Extraction
      avatarBox.innerHTML = '';
      var cardAvatar = cardEl.querySelector('.nav-card-avatar');
      if (cardAvatar) {
        var img = cardAvatar.querySelector('img');
        if (img && img.style.display !== 'none') {
          var popImg = document.createElement('img');
          popImg.src = img.src;
          popImg.alt = data.title || '';
          avatarBox.appendChild(popImg);
        } else {
          var svg = cardAvatar.querySelector('svg');
          if (svg) {
            avatarBox.innerHTML = svg.outerHTML;
          }
        }
      }
      if (!avatarBox.innerHTML.trim()) {
        avatarBox.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
      }

      // 4. Description
      descEl.textContent = data.description || '暂无详细介绍信息。';

      // 5. Dynamic Metrics Grid
      var metricsHtml = '';
      if (data.item_type === 'github' || data.repo) {
        if (data.stars) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">Stars</span><span class="qp-metric-value">⭐ ' + formatCount(data.stars) + '</span></div>';
        }
        if (data.forks) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">Forks</span><span class="qp-metric-value">🍴 ' + formatCount(data.forks) + '</span></div>';
        }
        if (data.language) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">Language</span><span class="qp-metric-value">' + esc(data.language) + '</span></div>';
        }
        if (data.license) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">License</span><span class="qp-metric-value">' + esc(data.license) + '</span></div>';
        }
      } else if (data.item_type === 'telegram' || (data.url && data.url.includes('t.me/'))) {
        if (data.member_count) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">订阅人数</span><span class="qp-metric-value">👥 ' + formatCount(data.member_count) + '</span></div>';
        }
        if (data.type) {
          var typeLabel = data.type === 'channel' ? '频道' : (data.type === 'group' ? '群组' : '机器人');
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">形态</span><span class="qp-metric-value">' + typeLabel + '</span></div>';
        }
      } else {
        if (data.pricing) {
          var priceLabel = data.pricing === 'free' ? '免费' : (data.pricing === 'freemium' ? '免费/内购' : data.pricing);
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">模式</span><span class="qp-metric-value">' + esc(priceLabel) + '</span></div>';
        }
        if (Array.isArray(data.platform) && data.platform.length > 0) {
          metricsHtml += '<div class="qp-metric-item"><span class="qp-metric-label">支持平台</span><span class="qp-metric-value">' + esc(data.platform.join('/')) + '</span></div>';
        }
      }

      if (metricsHtml) {
        metricsEl.innerHTML = metricsHtml;
        metricsEl.style.display = 'grid';
      } else {
        metricsEl.style.display = 'none';
      }

      // 6. Tags Cloud
      if (Array.isArray(data.tags) && data.tags.length > 0) {
        tagsEl.innerHTML = data.tags.map(function(t) {
          return '<span class="qp-tag-pill">' + esc(t) + '</span>';
        }).join('');
        tagsEl.parentElement.style.display = 'block';
      } else {
        tagsEl.parentElement.style.display = 'none';
      }

      // 7. Mirrors
      if (Array.isArray(data.mirror_urls) && data.mirror_urls.length > 0) {
        mirrorsList.innerHTML = data.mirror_urls.map(function(m, idx) {
          var mHost = '';
          try { mHost = new URL(m).hostname; } catch (e) { mHost = '镜像 ' + (idx + 1); }
          return '<a href="' + esc(m) + '" target="_blank" rel="noopener noreferrer" class="qp-mirror-btn"><span>⚡ ' + esc(mHost) + '</span></a>';
        }).join('');
        mirrorsSection.style.display = 'block';
      } else {
        mirrorsSection.style.display = 'none';
      }

      // 8. Footer Actions
      openLink.href = data.url || '#';
      
      var isPinned = false;
      if (typeof window.isNavFavorite === 'function') {
        isPinned = window.isNavFavorite(data.id);
      }
      if (isPinned) {
        pinBtn.classList.add('is-pinned');
        pinText.textContent = '已收藏';
      } else {
        pinBtn.classList.remove('is-pinned');
        pinText.textContent = '加入常用';
      }

      // 9. Smart Viewport Positioning
      repositionPopover(cardEl);

      popover.style.display = 'flex';
      requestAnimationFrame(function() {
        popover.classList.add('is-open');
        popover.setAttribute('aria-hidden', 'false');
        if (focusInside) {
          setTimeout(function() { pinBtn.focus(); }, 60);
        }
      });
    }

    // Position Popover with collision detection
    function repositionPopover(cardEl) {
      var rect = cardEl.getBoundingClientRect();
      var popoverWidth = 360;
      var padding = 14;

      popover.style.display = 'flex';
      var popoverHeight = popover.offsetHeight || 280;

      // Horizontal calculation: prefer Right, fallback Left
      var left = rect.right + padding;
      if (left + popoverWidth > window.innerWidth - 12) {
        left = rect.left - popoverWidth - padding;
      }
      if (left < 12) {
        left = Math.max(12, (window.innerWidth - popoverWidth) / 2);
      }

      // Vertical calculation: align with card center/top, prevent overflow
      var top = rect.top + (rect.height / 2) - (popoverHeight / 2);
      if (top + popoverHeight > window.innerHeight - 16) {
        top = window.innerHeight - popoverHeight - 16;
      }
      if (top < 16) {
        top = 16;
      }

      popover.style.left = Math.round(left) + 'px';
      popover.style.top = Math.round(top) + 'px';
    }

    function recycleDOM() {
      avatarBox.innerHTML = '';
      metricsEl.innerHTML = '';
      tagsEl.innerHTML = '';
      mirrorsList.innerHTML = '';
      currentCard = null;
      currentData = null;
    }

    function closePopover(returnFocus) {
      var cardToRefocus = currentCard;
      popover.classList.remove('is-open');
      popover.setAttribute('aria-hidden', 'true');
      setTimeout(function() {
        if (!popover.classList.contains('is-open')) {
          popover.style.display = 'none';
          recycleDOM();
          if (returnFocus && cardToRefocus && typeof cardToRefocus.focus === 'function') {
            cardToRefocus.focus();
          }
        }
      }, 220);
    }

    // Event Delegation: Mouse Hover on Cards
    document.addEventListener('mouseover', function(e) {
      var card = e.target.closest('.nav-card');
      if (card) {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
        if (currentCard === card && popover.classList.contains('is-open')) {
          return;
        }
        if (hoverTimer) clearTimeout(hoverTimer);
        hoverTimer = setTimeout(function() {
          openPopover(card, false);
        }, DEBOUNCE_MS);
      }
    });

    document.addEventListener('mouseout', function(e) {
      var card = e.target.closest('.nav-card');
      if (card) {
        if (hoverTimer) {
          clearTimeout(hoverTimer);
          hoverTimer = null;
        }
        closeTimer = setTimeout(function() {
          closePopover(false);
        }, CLOSE_DELAY_MS);
      }
    });

    // Keep Popover open when cursor enters Popover itself
    popover.addEventListener('mouseenter', function() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    });

    popover.addEventListener('mouseleave', function() {
      closeTimer = setTimeout(function() {
        closePopover(false);
      }, CLOSE_DELAY_MS);
    });

    // Accessibility: Focus Trap and Keyboard Shortcuts inside Popover
    popover.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.key === 'i' || e.key === 'I') {
        e.preventDefault();
        e.stopPropagation();
        closePopover(true);
        return;
      }

      if (e.key === 'Tab') {
        var focusable = Array.prototype.slice.call(
          popover.querySelectorAll('button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')
        ).filter(function(el) { return el.offsetParent !== null; });

        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    // Close on ESC key or window scroll/resize outside
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && popover.classList.contains('is-open')) {
        closePopover(true);
      }
    });

    window.addEventListener('scroll', function() {
      if (popover.classList.contains('is-open')) {
        closePopover(false);
      }
    }, { passive: true });

    // Actions inside Popover: Pin Button
    pinBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!currentData || !currentData.id) return;
      if (typeof window.toggleNavFavorite === 'function') {
        var isNowFav = window.toggleNavFavorite(currentData);
        if (isNowFav) {
          pinBtn.classList.add('is-pinned');
          pinText.textContent = '已收藏';
          if (typeof window.showNavToast === 'function') window.showNavToast('⭐ 已收藏至我的常用看板');
        } else {
          pinBtn.classList.remove('is-pinned');
          pinText.textContent = '加入常用';
          if (typeof window.showNavToast === 'function') window.showNavToast('✓ 已从我的常用中移除');
        }
      }
    });

    // Actions inside Popover: Copy Button
    copyBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!currentData) return;
      var shareUrl = window.location.origin + window.location.pathname + '#' + currentData.id;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(function() {
          if (typeof window.showNavToast === 'function') window.showNavToast('✓ 直达链接已复制到剪贴板');
        });
      }
    });

    // Global APIs for KeyboardNavigation and external triggers
    window.openNavQuickPreview = function(cardEl, focusInside) {
      openPopover(cardEl, focusInside !== false);
    };
    window.closeNavQuickPreview = function(returnFocus) {
      closePopover(returnFocus !== false);
    };
    window.isNavQuickPreviewOpen = function() {
      return popover.classList.contains('is-open');
    };
  })();
</script>

{
    "name": "spark-nav",
    "version": "1.1.0",
    "description": "Modern Cyberpunk / OLED Style Geek Navigation System & Open Source Matrix",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build && npm run search:index",
        "preview": "astro preview",
        "check": "astro check",
        "check:functions": "tsc -p tsconfig.functions.json",
        "test:unit": "node --test src/scripts/tests/*.test.mjs",
        "verify:pin-hit": "node src/scripts/verify-pin-hit-area.mjs",
        "verify:cloudsync": "node src/scripts/verify-cloud-sync-local.mjs",
        "search:index": "node src/scripts/build-nav-search-index.mjs",
        "nav:audit:tg": "node src/scripts/audit-telegram-sources.mjs",
        "nav:merge:tg": "node src/scripts/audit-telegram-sources.mjs --merge-only",
        "nav:import:tgnav": "node src/scripts/import-tgnav-sources.mjs --write",
        "nav:health": "node src/scripts/audit-nav-health.mjs",
        "nav:health:write": "node src/scripts/audit-nav-health.mjs --write",
        "nav:heal": "node src/scripts/audit-nav-health.mjs --write --auto-heal",
        "nav:cache:avatars": "node src/scripts/cache-nav-avatars.mjs",
        "nav:cache:avatars:write": "node src/scripts/cache-nav-avatars.mjs --write",
        "nav:add": "node src/scripts/ai-nav-ingest.mjs",
        "nav:review": "node src/scripts/nav-review.mjs",
        "nav:approve": "node src/scripts/nav-review.mjs --approve",
        "sync:creators": "node src/scripts/sync-creators.mjs --rebuild-search",
        "sync:nav": "node src/scripts/sync-nav.mjs",
        "bot:start": "node src/scripts/telegram-bot-daemon.mjs",
        "bot:once": "node src/scripts/telegram-bot-daemon.mjs --once",
        "check:media": "node src/scripts/check-media.mjs",
        "clean:processes": "node src/scripts/clean-orphan-processes.mjs",
        "verify:favorites": "node src/scripts/verify-nav-favorites.mjs"
    },
    "keywords": [
        "astro",
        "navigation",
        "geek",
        "telegram-bot",
        "github-matrix",
        "oled-theme",
        "static-site"
    ],
    "author": "SparkNav Contributors",
    "license": "MIT",
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@cloudflare/workers-types": "5.20260910.1",
        "astro": "^5.13.5",
        "playwright-core": "^1.63.0",
        "qrcode": "^1.5.4",
        "tiny-pinyin": "^1.3.2",
        "typescript": "^5.9.3",
        "wrangler": "4.131.0"
    }
}

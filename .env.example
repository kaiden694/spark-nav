# ==============================================================================
# SparkNav - 极客智汇导航系统环境配置模版 (.env.example)
# 使用方式:
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 根据实际部署环境填写相应密钥
#   3. .env 已被 .gitignore 忽略，切勿提交至公开 Git 仓库
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram 审批与自动收录机器人配置 (可选：用于自托管 VPS 守护进程)
# ------------------------------------------------------------------------------
# 机器人访问令牌（从 Telegram @BotFather 获取）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 接收审批卡片与通知的管理员 Chat ID（从 @userinfobot 获取）
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# 可选：Telegram 反向代理 API 地址（若部署环境受限，可填自建 CF Worker 反代）
# TELEGRAM_API_BASE=https://api.telegram.org

# ------------------------------------------------------------------------------
# 2. LLM 智能中文概括与润色引擎配置 (优先顺序: Gemini -> OpenAI兼容 -> Ollama)
# ------------------------------------------------------------------------------
# 【方案 1 - 推荐】Google Gemini API (推荐 gemini-2.5-flash / gemini-1.5-flash)
# 获取地址: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 【方案 2】OpenAI 兼容协议 (支持 DeepSeek / Kimi / 硅基流动 / 智谱 GLM 等)
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 【方案 3】本地 Ollama 离线大模型 (若本地已运行 Ollama 服务)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 3. 导航生态死链探活与 GitHub 配额
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (未配置时每小时限速 60 次，配置后 5000 次/小时)
# 用于 audit-nav-health.mjs 探活开源项目 Stars、Forks 与最新 Commit
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. 可选：外部媒体与头像代理上游 (若未配置，将默认自动启用内置纯 SVG 动态头像生成引擎)
# ------------------------------------------------------------------------------
# MEDIA_PROXY_UPSTREAM=https://your-custom-cdn.example.com

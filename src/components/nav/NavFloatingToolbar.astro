---
// NavFloatingToolbar.astro
// Global Navigation Right-side Floating Toolbar
// Includes: Quick Search, Online Submission, Telegram @xiunav_bot Hub, Broken Link Reporting, and Back to Top.
---

<aside class="nav-float-bar" id="nav-float-bar" aria-label="快捷工具栏">
  <!-- Item 1: Quick Search -->
  <div class="nav-float-item">
    <button type="button" class="nav-float-btn" id="nav-float-search-btn" title="快速全局检索 (⌘K / /)" aria-label="快速检索">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
    <span class="nav-float-tooltip">快速检索 <kbd>⌘K</kbd></span>
  </div>

  <!-- Item 2: Online Submission -->
  <div class="nav-float-item">
    <button type="button" class="nav-float-btn" id="nav-float-submit-btn" title="在线申请收录站点/工具" aria-label="在线收录">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v16m8-8H4"></path>
      </svg>
    </button>
    <span class="nav-float-tooltip">在线收录</span>
  </div>

  <!-- Item 3: Telegram Bot Hub -->
  <div class="nav-float-item nav-float-bot-item">
    <button type="button" class="nav-float-btn" id="nav-float-bot-btn" title="Telegram 机器人收录 (@xiunav_bot)" aria-label="Bot收录">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/>
      </svg>
    </button>
    <span class="nav-float-tooltip">Bot收录</span>

    <!-- Hover / Click Dropdown Card for Bot Info -->
    <div class="nav-float-bot-card" id="nav-float-bot-card">
      <div class="nav-bot-header">
        <div class="nav-bot-avatar">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="#fff"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/></svg>
        </div>
        <div class="nav-bot-title-wrap">
          <div class="nav-bot-name">xiunav 官方收录机器人</div>
          <div class="nav-bot-handle">@xiunav_bot</div>
        </div>
      </div>
      <p class="nav-bot-desc">支持频道、群组、开源项目及独立站点提交审核，7×24小时自动化初筛探活。</p>
      <div class="nav-bot-actions">
        <a href="https://t.me/xiunav_bot" target="_blank" rel="noopener noreferrer" class="nav-bot-cta-btn" id="nav-bot-open-btn">
          <span>🚀 打开 Telegram 对话</span>
        </a>
        <button type="button" class="nav-bot-copy-btn" id="nav-bot-copy-handle-btn" title="复制用户名 @xiunav_bot">
          📋 复制用户名
        </button>
      </div>
      <div class="nav-bot-tip">
        <span>💡 提示：也可以在 Telegram 中直接搜索 <strong>@xiunav_bot</strong> 发起提交</span>
      </div>
    </div>
  </div>

  <!-- Item 4: Broken Link / Feedback -->
  <div class="nav-float-item">
    <button type="button" class="nav-float-btn" id="nav-float-report-btn" title="站点失效 / 纠错反馈" aria-label="失效纠错">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    </button>
    <span class="nav-float-tooltip">失效纠错</span>
  </div>

  <!-- Item 5: Favorites Cloud Sync (Gist / WebDAV) -->
  <div class="nav-float-item">
    <button type="button" class="nav-float-btn" id="nav-float-sync-btn" title="常用收藏跨端同步 (Gist / WebDAV)" aria-label="云端同步">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
      </svg>
    </button>
    <span class="nav-float-tooltip">云端同步</span>
  </div>

  <!-- Item 6: Keyboard Shortcuts Guide (Desktop only) -->
  <div class="nav-float-item nav-float-desktop-only">
    <button type="button" class="nav-float-btn" id="nav-float-shortcuts-btn" title="全域快捷键漫游矩阵 (?)" aria-label="键盘快捷键">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
        <line x1="6" y1="8" x2="6.01" y2="8"></line>
        <line x1="10" y1="8" x2="10.01" y2="8"></line>
        <line x1="14" y1="8" x2="14.01" y2="8"></line>
        <line x1="18" y1="8" x2="18.01" y2="8"></line>
        <line x1="6" y1="12" x2="6.01" y2="12"></line>
        <line x1="10" y1="12" x2="10.01" y2="12"></line>
        <line x1="14" y1="12" x2="14.01" y2="12"></line>
        <line x1="18" y1="12" x2="18.01" y2="12"></line>
        <line x1="7" y1="16" x2="17" y2="16"></line>
      </svg>
    </button>
    <span class="nav-float-tooltip">键盘漫游 <kbd>?</kbd></span>
  </div>

  <!-- Item 6: Back to Top (Auto-hides when scrollTop < 300px) -->
  <div class="nav-float-item nav-float-totop-item" id="nav-float-totop-wrap">
    <button type="button" class="nav-float-btn nav-float-totop-btn" id="nav-float-totop-btn" title="平滑回到顶部" aria-label="回到顶部">
      <svg class="nav-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <span class="nav-float-tooltip">回到顶部</span>
  </div>
</aside>

<!-- ============================================================
     Modal 1: 在线收录模态框 (Online Submission Dialog)
     ============================================================ -->
<div class="nav-modal-backdrop" id="nav-submit-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="nav-submit-title">
  <div class="nav-modal-dialog">
    <div class="nav-modal-header">
      <div class="nav-modal-title-row">
        <span class="nav-modal-icon">📝</span>
        <div>
          <h3 class="nav-modal-title" id="nav-submit-title">在线申请收录</h3>
          <p class="nav-modal-subtitle">推荐优质工具、开源仓库或 Telegram 社群，审核通过后即刻展示</p>
        </div>
      </div>
      <button type="button" class="nav-modal-close" id="nav-submit-close" title="关闭 (Esc)">&times;</button>
    </div>

    <form class="nav-modal-body" id="nav-submit-form" onsubmit="return false;">
      <div class="nav-form-group">
        <label class="nav-form-label" for="sub-site-title">
          <span>资源 / 站点名称</span>
          <span class="nav-form-req">*</span>
        </label>
        <input type="text" id="sub-site-title" class="nav-form-input" placeholder="例如：Open WebUI、Mihomo、金十数据" required />
      </div>

      <div class="nav-form-group">
        <label class="nav-form-label" for="sub-site-url">
          <span>官网 / 仓库 / 频道链接</span>
          <span class="nav-form-req">*</span>
        </label>
        <input type="url" id="sub-site-url" class="nav-form-input" placeholder="https://..." required />
      </div>

      <div class="nav-form-row">
        <div class="nav-form-group" style="flex: 1;">
          <label class="nav-form-label" for="sub-site-cat">
            <span>所属专区分类</span>
            <span class="nav-form-req">*</span>
          </label>
          <select id="sub-site-cat" class="nav-form-select">
            <option value="featured">🌟 常用精选</option>
            <option value="tools">🛠️ 实用工具</option>
            <option value="github">💻 开源矩阵 (GitHub)</option>
            <option value="telegram">✈️ 电报生态 (Telegram)</option>
            <option value="creators">👤 优质博主 / 创作者</option>
          </select>
        </div>

        <div class="nav-form-group" style="flex: 1;">
          <label class="nav-form-label" for="sub-site-contact">
            <span>联系方式 (选填)</span>
          </label>
          <input type="text" id="sub-site-contact" class="nav-form-input" placeholder="Telegram / 邮箱 / GitHub" />
        </div>
      </div>

      <div class="nav-form-group">
        <label class="nav-form-label" for="sub-site-desc">
          <span>推荐理由 / 核心亮点简介</span>
        </label>
        <textarea id="sub-site-desc" class="nav-form-textarea" rows="3" placeholder="一两句话描述该资源的功能特色、受众群体或核心亮点..."></textarea>
      </div>

      <!-- Action Buttons -->
      <div class="nav-modal-footer">
        <button type="button" class="nav-btn-action nav-btn-bot" id="nav-submit-to-bot-btn">
          <span>🚀 发送给 @xiunav_bot</span>
        </button>
        <button type="button" class="nav-btn-action nav-btn-copy" id="nav-submit-copy-btn">
          <span>📋 复制申请文案</span>
        </button>
        <button type="button" class="nav-btn-action nav-btn-issue" id="nav-submit-issue-btn">
          <span>🐙 GitHub Issue</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================
     Modal 2: 站点失效与纠错反馈模态框 (Broken Link / Feedback Dialog)
     ============================================================ -->
<div class="nav-modal-backdrop" id="nav-report-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="nav-report-title">
  <div class="nav-modal-dialog">
    <div class="nav-modal-header">
      <div class="nav-modal-title-row">
        <span class="nav-modal-icon">🚨</span>
        <div>
          <h3 class="nav-modal-title" id="nav-report-title">站点失效 / 纠错反馈</h3>
          <p class="nav-modal-subtitle">发现打不开的死链、违规欺诈或描述有误？感谢你的守护</p>
        </div>
      </div>
      <button type="button" class="nav-modal-close" id="nav-report-close" title="关闭 (Esc)">&times;</button>
    </div>

    <form class="nav-modal-body" id="nav-report-form" onsubmit="return false;">
      <div class="nav-form-group">
        <label class="nav-form-label" for="rep-site-target">
          <span>出现问题的站点名称或网址</span>
          <span class="nav-form-req">*</span>
        </label>
        <input type="text" id="rep-site-target" class="nav-form-input" placeholder="输入站点名称或粘贴目标 URL" required />
      </div>

      <div class="nav-form-group">
        <label class="nav-form-label" for="rep-issue-type">
          <span>问题类型</span>
        </label>
        <select id="rep-issue-type" class="nav-form-select">
          <option value="broken">🔴 无法访问 / 域名已死 (404/DNS错误)</option>
          <option value="changed">🔄 域名变更 / 跳转至其他地址</option>
          <option value="scam">⚠️ 涉及钓鱼欺诈 / 违规内容</option>
          <option value="cat_err">🏷️ 分类划分有误 (应调整业务分类/子类)</option>
          <option value="info_err">✏️ 标题描述有误 / 图标失真</option>
        </select>
      </div>

      <div class="nav-form-group">
        <label class="nav-form-label" for="rep-issue-details">
          <span>补充说明 (选填)</span>
        </label>
        <textarea id="rep-issue-details" class="nav-form-textarea" rows="3" placeholder="例如：新网址是 xxx.com，或者国内网络打不开..."></textarea>
      </div>

      <!-- Action Buttons -->
      <div class="nav-modal-footer">
        <button type="button" class="nav-btn-action nav-btn-bot" id="nav-report-to-bot-btn">
          <span>🚀 发送给 @xiunav_bot 纠错</span>
        </button>
        <button type="button" class="nav-btn-action nav-btn-copy" id="nav-report-copy-btn">
          <span>📋 复制报错文案</span>
        </button>
      </div>
    </form>
  </div>
</div>

<style is:global>
  /* ============================================================
     Right-side Floating Toolbar Styles
     ============================================================ */
  .nav-float-bar {
    position: fixed;
    right: 22px;
    bottom: 36px;
    z-index: 990;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

  .nav-float-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-float-btn {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(18, 22, 34, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    padding: 0;
  }

  .nav-float-btn:hover {
    background: rgba(30, 41, 59, 0.95);
    border-color: rgba(56, 189, 248, 0.45);
    color: var(--nav-accent, #38bdf8);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5), 0 0 16px rgba(56, 189, 248, 0.2);
  }

  .nav-float-btn:active {
    transform: translateY(0) scale(0.96);
  }

  .nav-float-icon {
    width: 20px;
    height: 20px;
    display: block;
    transition: transform 0.2s ease;
  }

  .nav-float-btn:hover .nav-float-icon {
    transform: scale(1.08);
  }

  /* Tooltip on Left */
  .nav-float-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: rgba(15, 23, 42, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f1f5f9;
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    transition: opacity 0.18s ease, transform 0.18s ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-float-tooltip kbd {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1px 4px;
    border-radius: 4px;
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--nav-accent, #38bdf8);
  }

  .nav-float-item:hover .nav-float-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Back to top item */
  .nav-float-totop-item {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .nav-float-totop-item.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Telegram Bot Dropdown Card */
  .nav-float-bot-card {
    position: absolute;
    right: calc(100% + 14px);
    bottom: 0;
    width: 280px;
    background: rgba(18, 22, 34, 0.97);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65), 0 0 24px rgba(14, 165, 233, 0.15);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
    pointer-events: none;
    transform: translateX(10px) scale(0.96);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
  }

  .nav-float-bot-item.is-open .nav-float-bot-card,
  .nav-float-bot-item:hover .nav-float-bot-card {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0) scale(1);
  }

  .nav-bot-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .nav-bot-avatar {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #0ea5e9, #2563eb);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-bot-title-wrap {
    min-width: 0;
    flex: 1;
  }

  .nav-bot-name {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-bot-handle {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--nav-accent, #38bdf8);
    font-weight: 600;
  }

  .nav-bot-desc {
    font-size: 11.5px;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 12px 0;
  }

  .nav-bot-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-bot-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    background: linear-gradient(135deg, #0284c7, #0ea5e9);
    border-radius: 8px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.35);
  }

  .nav-bot-cta-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    color: #ffffff;
  }

  .nav-bot-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #cbd5e1;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .nav-bot-copy-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .nav-bot-tip {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
    font-size: 10.5px;
    color: #64748b;
    line-height: 1.4;
  }

  /* ============================================================
     Modals: Online Submit & Broken Link Report
     ============================================================ */
  .nav-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10001;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-modal-backdrop.is-open {
    opacity: 1;
  }

  .nav-modal-dialog {
    width: 100%;
    max-width: 520px;
    background: rgba(18, 22, 34, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    transform: scale(0.96) translateY(10px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
